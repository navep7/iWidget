<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rl_widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@drawable/gradient_glass"
    android:gravity="center"
    android:orientation="vertical"
    android:theme="@style/Theme.Material3.DynamicColors.Light">


    <RelativeLayout
        android:id="@+id/rl_clocks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/gradient_glass_flatbottom">

        <LinearLayout
            android:id="@+id/ll_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tx_wish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="a Wish.."
                android:textColor="?attr/colorPrimaryDark"
                android:textSize="33sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <ImageButton
                android:id="@+id/fab_torch"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/weather_rounded_corner"
                android:gravity="center"
                android:padding="5dp"
                android:scaleType="fitXY"
                android:src="@drawable/torch_off"
                tools:ignore="HardcodedText" />

            <ImageButton
                android:id="@+id/fab_wifi"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/weather_rounded_corner"
                android:gravity="center"
                android:padding="5dp"
                android:scaleType="fitXY"
                android:src="@drawable/wifi_off"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tx_reminders"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/rounded_corner_gray"
                android:gravity="center"
                android:padding="5dp"
                android:scaleType="fitXY"
                android:text="🔔"
                tools:ignore="HardcodedText" />

            <ImageButton
                android:id="@+id/fab_blue"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/weather_rounded_corner"
                android:gravity="center"
                android:padding="5dp"
                android:scaleType="fitXY"
                android:src="@drawable/blue_off"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tx_ai"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/rounded_corner_gray"
                android:gravity="center"
                android:padding="5dp"
                android:scaleType="fitXY"
                android:text="✨"
                tools:ignore="HardcodedText" />

        </LinearLayout>


        <!-- <ImageButton
             android:id="@+id/fab_camera"
             android:layout_width="35dp"
             android:layout_height="35dp"
             android:layout_alignParentTop="true"
             android:layout_marginTop="5dp"
             android:layout_marginStart="3dp"
             android:layout_toEndOf="@+id/fab_settings"
             android:background="@drawable/weather_rounded_corner"
             android:gravity="center"
             android:padding="5dp"
             android:scaleType="fitXY"
             android:src="@android:drawable/ic_menu_camera"
             tools:ignore="HardcodedText" />

         <ImageButton
             android:id="@+id/fab_settings"
             android:layout_width="35dp"
             android:layout_height="35dp"
             android:layout_alignParentTop="true"
             android:layout_marginTop="5dp"
             android:layout_marginStart="3dp"
             android:layout_toEndOf="@+id/fab_torch"
             android:background="@drawable/weather_rounded_corner"
             android:gravity="center"
             android:padding="5dp"
             android:scaleType="fitXY"
             android:src="@drawable/settings"
             tools:ignore="HardcodedText" />-->


        <TextView
            android:id="@+id/tx_weather_icon_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/weather_icon"
            android:layout_alignEnd="@+id/weather_icon"
            android:layout_marginBottom="-45dp"
            android:background="@drawable/gradient_glass"
            android:scaleType="fitXY"
            android:text="25°C"
            android:textColor="?attr/colorTertiary"
            android:textSize="25dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tx_weather_icon_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/weather_icon"
            android:layout_alignStart="@+id/weather_icon"
            android:layout_marginBottom="-20dp"
            android:background="@drawable/gradient_glass"
            android:scaleType="fitXY"
            android:text="State..,"
            android:textColor="?attr/colorTertiary"
            android:textStyle="bold" />


        <ImageButton
            android:id="@+id/weather_icon"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_below="@+id/ll_top"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/fab_margin"
            android:layout_marginEnd="5dp"
            android:background="@drawable/weather_rounded_corner"
            android:scaleType="fitXY"
            android:src="@drawable/clouds" />

        <ImageView
            android:id="@+id/animation_image"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_below="@+id/ll_top"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/fab_margin"
            android:layout_marginEnd="5dp"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/tx_live_weather_effects"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_below="@+id/ll_top"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="25dp"
            android:layout_marginEnd="50dp"
            android:gravity="center"
            android:scaleType="fitXY"
            android:text="☄"
            android:textSize="35sp"
            android:visibility="invisible" />


        <TextView
            android:id="@+id/tx_ref_weather_icon"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_below="@+id/ll_top"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/fab_margin"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:scaleType="fitXY"
            android:text="↻"
            android:textSize="50sp" />


        <AnalogClock
            android:id="@+id/a_clock"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_above="@+id/tx_place"
            android:layout_below="@+id/ll_top"
            android:dial="@drawable/walp_icon"
            android:hand_second="@drawable/s_hand" />

        <android.widget.TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_top"
            android:layout_toEndOf="@+id/a_clock"
            android:format24Hour="k:mm:ss"
            android:textColor="?attr/colorPrimaryDark"
            android:textSize="35sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tx_day_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/clock"
            android:layout_marginEnd="@dimen/fab_margin"
            android:layout_toEndOf="@+id/a_clock"
            android:text="Day│Date"
            android:textColor="?attr/colorPrimaryDark"
            android:textSize="25sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />


        <TextView
            android:id="@+id/tx_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tx_day_date"
            android:layout_marginStart="@dimen/fab_margin"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text="Place"
            android:textColor="?attr/colorPrimaryDark"
            android:textSize="15sp"
            android:textStyle="bold">

            <requestFocus />
        </TextView>

    </RelativeLayout>


    <ImageView
        android:id="@+id/imgv_apps"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_below="@+id/rl_steps"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/ll_controls"
        android:src="@drawable/launch_e" />


    <ListView
        android:id="@+id/list_apps"
        android:background="@drawable/gradient_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/imgv_add_contacts"
        android:layout_below="@+id/imgv_contacts"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/ll_controls" />


    <ImageView
        android:id="@+id/imgv_add_apps"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_above="@+id/tx_tweets"
        android:layout_alignStart="@+id/imgv_apps"
        android:layout_toStartOf="@+id/ll_controls"
        android:src="@android:drawable/ic_input_add" />

    <ImageView
        android:id="@+id/imgv_contacts"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_below="@+id/rl_steps"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@+id/ll_controls"
        android:src="@drawable/contacts" />


    <ListView
        android:id="@+id/list_contacts"
        android:background="@drawable/gradient_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/imgv_add_contacts"
        android:layout_below="@+id/imgv_contacts"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@+id/ll_controls" />


    <ImageView
        android:id="@+id/imgv_add_contacts"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_above="@+id/tx_tweets"
        android:layout_alignStart="@+id/imgv_contacts"
        android:layout_alignParentEnd="true"
        android:src="@android:drawable/ic_input_add" />


    <LinearLayout
        android:id="@+id/ll_controls"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_below="@+id/rl_steps"
        android:layout_centerHorizontal="true">

        <ImageButton
            android:id="@+id/imgbtn_location"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/rounded_corner_white"
            android:padding="5dp"
            android:scaleType="fitXY"
            android:src="@drawable/location" />

        <ImageButton
            android:id="@+id/imgbtn_conf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/rounded_corner_white"
            android:padding="5dp"
            android:src="@android:drawable/ic_menu_search" />


        <ImageButton
            android:id="@+id/imgbtn_speech"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/rounded_corner_white"
            android:padding="5dp"
            android:scaleType="fitXY"
            android:src="@android:drawable/ic_btn_speak_now" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_controls2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/ll_controls"
        android:layout_centerHorizontal="true">


        <ImageButton
            android:id="@+id/imgbtn_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/rounded_corner_black"
            android:padding="5dp"
            android:src="@android:drawable/ic_lock_lock" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/imgbtn_set"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/rounded_corner_black"
                android:padding="5dp"
                android:src="@android:drawable/ic_popup_sync" />

            <ProgressBar
                android:id="@+id/progressBar_cyclic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:indeterminate="true"
                android:indeterminateTint="?attr/colorSecondary"
                android:indeterminateTintMode="src_atop"
                android:minWidth="25dp"
                android:minHeight="25dp"
                android:visibility="invisible" />


            <TextView
                android:id="@+id/tx_rewards_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_glass_flatbottom"
                android:text="5"
                android:textColor="@android:color/holo_red_light"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

        </RelativeLayout>


    </LinearLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/fab_share"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="-55dp"
        android:layout_alignStart="@+id/rl_screentime"
        android:layout_below="@+id/rl_screentime"
        android:layout_toStartOf="@+id/list_contacts">

        <LinearLayout
            android:id="@+id/ll_gapps_napps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_alignParentTop="true"
            android:orientation="horizontal"
            android:weightSum="2">

            <ImageButton
                android:id="@+id/imgbtn_g_apps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="G"
                android:scaleType="fitCenter"
                android:src="@drawable/gapps_logo_bnw"
                tools:ignore="HardcodedText" />


            <ImageButton
                android:id="@+id/imgbtn_n_apps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="N"
                android:scaleType="fitCenter"
                android:src="@drawable/my_space_bnw"
                android:weightSum="3"
                tools:ignore="HardcodedText" />


        </LinearLayout>

        <ImageButton
            android:id="@+id/imgbtn_qr"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:background="@android:color/transparent"
            android:contentDescription="QR"
            android:scaleType="fitCenter"
            android:src="@drawable/qr_logo_bnw"
            tools:ignore="HardcodedText" />


    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/rl_screentime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_controls2"
        android:layout_centerHorizontal="true"
        android:layout_margin="5dp"
        android:background="@drawable/gradient_glass_rounded">

        <TextView
            android:id="@+id/tx_st_since"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="since..."
            android:textStyle="bold|italic" />

        <TextView
            android:id="@+id/btn_screentime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fab_margin"
            android:background="@android:color/transparent"
            android:text="ON ~ 10+ H"
            android:textColor="@android:color/holo_red_light"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tx_screentime_info"
            android:layout_below="@+id/btn_screentime"
            android:layout_centerHorizontal="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ⓘ"
            android:textSize="35sp"
            android:textStyle="bold"/>


    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_steps"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:layout_below="@+id/rl_clocks"
        android:background="@drawable/rounded_corner_gray">

        <TextView
            android:id="@+id/txx_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:text="Steps,"
            android:textColor="@android:color/white"
            android:textStyle="bold|italic" />

        <ImageButton
            android:id="@+id/imgv_steps"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_toEndOf="@+id/txx_steps"
            android:background="@android:color/transparent"
            android:scaleType="fitXY"
            android:src="@drawable/steps" />

        <TextView
            android:id="@+id/tx_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/imgv_steps"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tx_now_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_toStartOf="@+id/tx_steps_info"
            android:text=" + "
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/vertical_divider"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_toEndOf="@+id/tx_steps"
            android:background="@android:color/black"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/tx_n_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/vertical_divider"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tx_steps_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="5dp"
            android:text="ⓘ"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />


    </RelativeLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tx_tweets"
        android:layout_margin="5dp"
        android:layout_toLeftOf="@+id/fab_share"
        android:layout_toRightOf="@+id/twSettings"
        android:background="@drawable/gradient_glass_rounded"
        android:visibility="gone">

        <TextView
            android:id="@+id/tx_sname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:text="Song name.." />

        <ImageButton
            android:id="@+id/imgbtn_media_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/tx_sname"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous" />


        <ImageButton
            android:id="@+id/imgbtn_media_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/imgbtn_media_prev"
            android:background="@drawable/gradient_glass_rounded"
            android:src="@android:drawable/ic_media_play" />


        <ImageButton
            android:id="@+id/imgbtn_media_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/imgbtn_media_play_pause"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_next" />


    </RelativeLayout>

    <ImageButton
        android:id="@+id/twSettings"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_above="@+id/tx_tweets"
        android:layout_toRightOf="@+id/list_apps"
        android:background="@drawable/gradient_glass"
        android:padding="5dp"
        android:scaleType="fitXY"
        android:src="@drawable/tw" />


    <ImageButton
        android:id="@+id/fab_share"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_above="@+id/tx_tweets"
        android:layout_toStartOf="@+id/list_contacts"
        android:background="@drawable/weather_rounded_corner"
        android:gravity="center"
        android:src="@android:drawable/ic_menu_share"
        tools:ignore="HardcodedText" />


    <TextView
        android:id="@+id/tx_tweets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tx_desc_walltype"
        android:layout_marginBottom="3dp"
        android:autoLink="all"
        android:background="#80FFFFFF"
        android:ellipsize="end"
        android:gravity="center"
        android:linksClickable="true"
        android:maxLines="3"
        android:text="Tweets"
        android:textColor="?attr/colorPrimaryDark"
        android:textSize="15sp"
        android:textStyle="bold" />


    <TextView
        android:id="@+id/tx_desc_walltype"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:autoLink="web"
        android:background="@drawable/gradient_glass_flattop"
        android:gravity="center"
        android:linksClickable="true"
        android:text="..."
        android:textColor="?attr/colorPrimaryDark"
        android:textStyle="bold" />


</RelativeLayout>