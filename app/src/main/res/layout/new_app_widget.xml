<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rl_widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="vertical"
    android:theme="@style/Theme.Material3.DynamicColors.Light">


    <ImageView
        android:id="@+id/imgv_widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <RelativeLayout
        android:id="@+id/rl_clocks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:paddingBottom="@dimen/padding_5">


        <LinearLayout
            android:id="@+id/ll_top"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/gradient_glass_flatbottom"
            android:paddingEnd="@dimen/padding_5"
            android:weightSum="9">

            <TextView
                android:id="@+id/tx_wish"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="@dimen/fab_margin"
                android:layout_marginEnd="@dimen/padding_5"
                android:layout_weight="4"
                android:text="..Greet!"
                android:textColor="@android:color/black"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />


            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="35dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="1"
                android:gravity="center">

                <ProgressBar
                    android:id="@+id/progressBar_battery"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="75"
                    android:progressDrawable="@drawable/circular_progress_drawable" />

                <TextView
                    android:id="@+id/tx_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="⚡"
                    android:textColor="@android:color/holo_red_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </RelativeLayout>


            <ImageButton
                android:id="@+id/fab_torch"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_corner_gray"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/torch_off"
                android:tint="@android:color/darker_gray"
                tools:ignore="HardcodedText" />

            <ImageButton
                android:id="@+id/fab_wifi"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_corner_gray"
                android:gravity="center"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/wifi_off"
                tools:ignore="HardcodedText" />


            <ImageButton
                android:id="@+id/fab_blue"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_corner_gray"
                android:gravity="center"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/blue_off" />

            <ImageButton
                android:id="@+id/fab_ai"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_corner_gray"
                android:gravity="center"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/ai" />

        </LinearLayout>


        <RelativeLayout
            android:id="@+id/rl_clocks_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/ll_top"
            android:background="@drawable/gradient_glass_dark">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_margin="@dimen/padding_5"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tx_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Weather Info..."
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />


                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageButton
                        android:id="@+id/imgv_weather_icon"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:background="@android:color/transparent"
                        android:scaleType="fitXY"
                        android:src="@drawable/clouds" />

                    <ProgressBar
                        android:id="@+id/progressBar_cyclic_weather"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignBottom="@+id/tx_refresh_weather"
                        android:layout_toRightOf="@+id/imgv_weather_icon"
                        android:indeterminate="true"
                        android:indeterminateTint="?attr/colorSecondary"
                        android:indeterminateTintMode="src_atop"
                        android:minWidth="5dp"
                        android:minHeight="5dp"
                        android:visibility="invisible" />

                    <TextView
                        android:id="@+id/tx_refresh_weather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignBaseline="@+id/tx_weather"
                        android:layout_toRightOf="@+id/imgv_weather_icon"
                        android:text="↺"
                        android:textColor="@android:color/holo_green_light"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_margin="@dimen/padding_5"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tx_place"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="155dp"
                    android:maxLines="1"
                    android:text="Place Information.."
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tx_get_place"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@+id/tx_place"
                    android:text=" ⚲"
                    android:textColor="@android:color/holo_green_light"
                    android:textSize="25sp"
                    android:textStyle="bold" />


            </LinearLayout>

            <FrameLayout
                android:id="@+id/frame_texts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">

                <AnalogClock
                    android:id="@+id/a_clock"
                    android:layout_width="102dp"
                    android:layout_height="98dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-24dp"
                    android:dial="@drawable/dialcircle"
                    android:dialTint="@android:color/transparent"
                    android:hand_hourTint="@android:color/white"
                    android:hand_minuteTint="@android:color/black"
                    android:hand_second="@drawable/s_hand"
                    android:hand_secondTint="@android:color/holo_red_light"
                    android:visibility="invisible"
                    tools:ignore="UnusedAttribute" />


                <LinearLayout
                    android:id="@+id/ll_time_day"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/padding_3"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_5">


                    <TextView
                        android:id="@+id/tx_time_announcement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="⊘"
                        android:textColor="@android:color/holo_green_light"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tx_day_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="Fri, 13th Apr"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <android.widget.TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="@dimen/padding_5"
                        android:layout_marginEnd="@dimen/padding_5"
                        android:format12Hour="h:mm:ss"
                        android:textColor="@android:color/holo_red_light"
                        android:textSize="35sp"
                        android:textStyle="bold" />


                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                android:id="@+id/ll_steps_screentime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/frame_texts"
                android:gravity="center_horizontal"
                android:orientation="horizontal">


                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/padding_5"
                    android:background="@drawable/gradient_glass_rounded">

                    <ImageButton
                        android:id="@+id/imgv_steps"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@android:color/transparent"
                        android:scaleType="fitXY"
                        android:src="@drawable/steps" />

                    <TextView
                        android:id="@+id/tx_steps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@+id/imgv_steps"
                        android:text="Steps, today."
                        android:textColor="@android:color/black"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <ImageButton
                    android:id="@+id/imgbtn_twitter"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="3dp"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:scaleType="fitXY"
                    android:src="@drawable/tw"
                    tools:ignore="HardcodedText" />


                <RelativeLayout
                    android:id="@+id/rl_screentime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/padding_5"
                    android:background="@drawable/gradient_glass_rounded">


                    <ImageButton
                        android:id="@+id/imgv_scr_time"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@android:color/transparent"
                        android:scaleType="fitXY"
                        android:src="@drawable/scr_time" />


                    <TextView
                        android:id="@+id/btn_screentime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/padding_5"
                        android:layout_toEndOf="@+id/imgv_scr_time"
                        android:background="@android:color/transparent"
                        android:text="Screen Time"
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </RelativeLayout>


            </LinearLayout>


        </RelativeLayout>

        <ImageView
            android:id="@+id/imgv_p_album"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignBottom="@+id/rl_player"
            android:layout_alignParentEnd="true" />


        <RelativeLayout
            android:id="@+id/rl_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_clocks_weather"
            android:layout_marginTop="@dimen/padding_3"
            android:layout_toStartOf="@+id/imgv_p_album"
            android:background="@drawable/gradient_glass_flat">

            <ImageView
                android:id="@+id/imgv_player"
                android:layout_width="match_parent"
                android:layout_height="35dp" />


            <ImageButton
                android:id="@+id/imgbtn_playpause"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_alignParentStart="true"
                android:layout_marginStart="@dimen/padding_5"
                android:layout_marginEnd="@dimen/padding_5"
                android:background="@android:color/transparent"
                android:scaleType="fitXY"
                android:src="@drawable/play_m" />

            <TextView
                android:id="@+id/tx_music_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/imgbtn_playpause"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Play..."
                android:textColor="@android:color/white"
                android:textStyle="bold|italic" />

        </RelativeLayout>


    </RelativeLayout>


    <TextView
        android:id="@+id/tx_runner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_clocks"
        android:layout_centerHorizontal="true"
        android:background="@drawable/gradient_glass_rounded_go"
        android:clickable="true"
        android:ellipsize="middle"
        android:focusable="true"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        android:maxLines="3"
        android:orientation="horizontal"
        android:padding="7dp"
        android:text=" Pin a Note! "
        android:textColor="@android:color/white"
        android:textStyle="bold" />


    <TextView
        android:id="@+id/tx_apps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tx_walldesc"
        android:layout_below="@+id/tx_runner"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/ll_apps"
        android:gravity="center"
        android:text="↑\nA\nP\nP\nS\n↓"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="35sp"
        android:textStyle="bold"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tx_calls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tx_walldesc"
        android:layout_below="@+id/tx_runner"
        android:layout_alignParentEnd="true"
        android:layout_toStartOf="@+id/ll_contacts"
        android:gravity="center"
        android:text="↑\nC\nA\nL\nL\nS\n↓"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="35sp"
        android:textStyle="bold"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/ll_apps"
        android:layout_width="85dp"
        android:layout_height="match_parent"
        android:layout_above="@+id/tx_walldesc"
        android:layout_alignTop="@+id/tx_runner"
        android:layout_alignParentStart="true"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_glass_rounded_ss"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgv_apps"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:scaleType="centerCrop"
                android:src="@drawable/launch_e" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:padding="@dimen/padding_5"
                android:text="Apps"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="15sp"
                android:textStyle="bold" />


        </LinearLayout>


        <ListView
            android:id="@+id/list_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false" />


    </LinearLayout>


    <LinearLayout
        android:id="@+id/ll_contacts"
        android:layout_width="85dp"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tx_walldesc"
        android:layout_alignTop="@+id/tx_runner"
        android:layout_alignParentEnd="true"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_glass_rounded_ss"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgv_contacts"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:scaleType="centerCrop"
                android:src="@drawable/contacts" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:padding="@dimen/padding_5"
                android:text="Calls"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="15sp"
                android:textStyle="bold" />


        </LinearLayout>


        <ListView
            android:id="@+id/list_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false"
            android:verticalScrollbarPosition="left" />

    </LinearLayout>


    <ImageView
        android:id="@+id/imgv_rl_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/tx_walldesc"
        android:layout_below="@+id/tx_runner"
        android:layout_toStartOf="@+id/ll_contacts"
        android:layout_toEndOf="@+id/ll_apps"
        android:scaleType="fitXY" />



    <LinearLayout
        android:weightSum="10"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/tx_walldesc"
        android:layout_below="@+id/tx_runner"
        android:layout_toStartOf="@+id/ll_contacts"
        android:layout_toEndOf="@+id/ll_apps"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/rl_controls"
            android:layout_width="match_parent"
            android:background="@drawable/gradient_glass_light"
            android:layout_height="0dp"
            android:layout_weight="6"
            android:gravity="center">

            <RelativeLayout
                android:id="@+id/rl_setwall"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="@dimen/padding_5"
                android:adjustViewBounds="true"
                android:background="@drawable/gradient_glass_rounded_go">

                <TextView
                    android:id="@+id/tx_rewards_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="@android:color/holo_red_light"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />


                <ImageButton
                    android:id="@+id/imgbtn_set"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:layout_marginBottom="@dimen/padding_5"
                    android:adjustViewBounds="true"
                    android:background="@android:color/transparent"
                    android:padding="@dimen/padding_3"
                    android:scaleType="fitXY"
                    android:src="@android:drawable/ic_popup_sync"
                    app:tint="@android:color/white" />

                <ProgressBar
                    android:id="@+id/progressBar_cyclic_wallchange"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:layout_marginBottom="@dimen/padding_5"
                    android:indeterminate="true"
                    android:indeterminateTint="@android:color/holo_red_dark"
                    android:indeterminateTintMode="src_atop"
                    android:minWidth="5dp"
                    android:minHeight="5dp"
                    android:visibility="invisible" />

            </RelativeLayout>

            <ImageView
                android:id="@+id/imgv_conf"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_above="@+id/rl_setwall"
                android:layout_alignStart="@+id/rl_setwall"
                android:layout_marginBottom="@dimen/padding_5"
                android:adjustViewBounds="true"
                android:background="@drawable/gradient_glass_rounded_go"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/conf" />

            <ImageButton
                android:id="@+id/imgbtn_speech"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_above="@id/rl_setwall"
                android:layout_marginStart="@dimen/fab_margin"
                android:layout_marginBottom="@dimen/fab_margin"
                android:layout_toEndOf="@+id/imgv_conf"
                android:background="@drawable/gradient_glass_rounded"
                android:scaleType="fitXY"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/imgv_dialler"
                android:layout_width="35dp"
                android:layout_height="40dp"
                android:layout_below="@id/rl_setwall"
                android:layout_marginStart="@dimen/fab_margin"
                android:layout_marginTop="@dimen/fab_margin"
                android:layout_toEndOf="@+id/imgv_conf"
                android:background="@drawable/gradient_glass_rounded"
                android:scaleType="fitXY"
                android:src="@drawable/dial"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/imgv_ps"
                android:layout_width="35dp"
                android:layout_height="40dp"
                android:layout_below="@id/rl_setwall"
                android:layout_marginTop="@dimen/fab_margin"
                android:layout_marginEnd="@dimen/fab_margin"
                android:layout_toStartOf="@+id/imgv_conf"
                android:background="@drawable/gradient_glass_rounded"
                android:scaleType="fitXY"
                android:src="@android:drawable/ic_media_play" />

            <ImageButton
                android:id="@+id/imgbtn_g_apps"
                android:layout_width="35dp"
                android:layout_height="40dp"
                android:layout_above="@id/rl_setwall"
                android:layout_marginEnd="@dimen/fab_margin"
                android:layout_marginBottom="@dimen/fab_margin"
                android:layout_toStartOf="@+id/imgv_conf"
                android:background="@drawable/gradient_glass_rounded"
                android:scaleType="centerCrop"
                android:src="@drawable/g1" />

            <ImageButton
                android:id="@+id/imgbtn_lock"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="@dimen/padding_5"
                android:layout_toEndOf="@+id/rl_setwall"
                android:adjustViewBounds="true"
                android:background="@drawable/gradient_glass_rounded_go"
                android:scaleType="fitXY"
                android:src="@android:drawable/ic_lock_lock"
                app:tint="@android:color/holo_red_dark" />

            <ImageView
                android:id="@+id/imgbtn_qr"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="@dimen/padding_5"
                android:layout_toStartOf="@+id/rl_setwall"
                android:adjustViewBounds="true"
                android:background="@drawable/gradient_glass_rounded_go"
                android:padding="@dimen/padding_5"
                android:src="@drawable/qr" />

            <TextView
                android:id="@+id/tx_myspace"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_below="@+id/rl_setwall"
                android:layout_alignStart="@+id/rl_setwall"
                android:layout_marginTop="@dimen/padding_5"
                android:background="@drawable/gradient_glass_rounded_ss"
                android:gravity="center"
                android:text="User"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <LinearLayout
            android:layout_weight="2"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tx_prevstate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_controls"
                android:layout_marginEnd="@dimen/fab_margin"
                android:layout_toStartOf="@+id/tx_activity_state"
                android:background="@drawable/gradient_glass_dark"
                android:padding="7dp"
                android:text=" &lt;"
                android:textSize="25sp"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tx_activity_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="sans-serif"
                android:text="State"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tx_nextstate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_controls"
                android:layout_marginStart="@dimen/fab_margin"
                android:layout_toEndOf="@+id/tx_activity_state"
                android:background="@drawable/gradient_glass_dark"
                android:padding="7dp"
                android:textSize="25sp"
                android:text=" &gt;"
                android:textColor="@color/white"
                android:textStyle="bold" />

        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2">

        <LinearLayout
            android:id="@+id/rl_still_state"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:layout_margin="@dimen/padding_5">

            <TextView
                android:id="@+id/tx_breathe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/padding_3"
                android:background="@drawable/circular_red"
                android:padding="@dimen/fab_margin"
                android:text="🌿"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tx_breathe_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-20.5dp"
                android:layout_marginBottom="21dp"
                android:background="@drawable/circular_white"
                android:gravity="end"
                android:padding="3sp"
                android:text="0"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />


            <TextView
                android:id="@+id/tx_nextplan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/circular_red"
                android:padding="@dimen/fab_margin"
                android:text=" ? "
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 𐃯 💧 🥛-->

            <TextView
                android:id="@+id/tx_drink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/padding_3"
                android:background="@drawable/circular_red"
                android:padding="@dimen/fab_margin"
                android:text=" 𐃯 "
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tx_drink_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-20.5dp"
                android:layout_marginBottom="21dp"
                android:background="@drawable/circular_white"
                android:gravity="end"
                android:padding="3sp"
                android:text="0"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

        </LinearLayout>


        <RelativeLayout
            android:id="@+id/rl_walking_state"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@+id/ll_contacts"
            android:layout_toEndOf="@+id/ll_apps"
            android:gravity="center">

            <TextView
                android:id="@+id/tx_stepstoday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:background="@drawable/gradient_glass_light"
                android:letterSpacing="0.2"
                android:padding="@dimen/padding_5"
                android:text="Steps ~"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tx_steps_km_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tx_stepstoday"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/padding_3"
                android:background="@drawable/gradient_glass_light"
                android:letterSpacing="0.2"
                android:padding="@dimen/padding_3"
                android:text="Distance ~ "
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

        </RelativeLayout>


        <FrameLayout
            android:id="@+id/fl_speed"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY">


            <!-- The gauge dial background -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="-25dp"
                android:scaleType="fitXY"
                android:src="@drawable/speed_guage"
                android:visibility="invisible" />

            <!-- The Needle -->
            <ImageView
                android:id="@+id/needle"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="-21dp"
                android:scaleType="fitXY" /> <!-- Start position -->

            <TextView
                android:id="@+id/tx_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/gradient_glass_light"
                android:gravity="center"
                android:padding="@dimen/padding_5"
                android:text="XxX KmpH"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="25sp"
                android:textStyle="bold" />


        </FrameLayout>

        </RelativeLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty_view_contacts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/tx_walldesc"
        android:layout_below="@+id/ll_contacts"
        android:layout_alignParentEnd="true"
        android:layout_toStartOf="@+id/ll_contacts"
        android:background="@drawable/gradient_glass"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_empty_view_apps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/tx_walldesc"
        android:layout_below="@+id/ll_apps"
        android:layout_alignParentEnd="true"
        android:layout_toStartOf="@+id/ll_apps"
        android:background="@drawable/gradient_glass"
        android:visibility="gone" />


    <TextView
        android:id="@+id/tx_walldesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/line2"
        android:background="@drawable/gradient_glass_dark_flat"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/line2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/tx_walltype_updateinfo"
        android:background="@android:color/black" />


    <TextView
        android:id="@+id/tx_walltype_updateinfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:autoLink="web"
        android:background="@drawable/gradient_glass_flattop"
        android:gravity="center"
        android:linksClickable="true"
        android:text="..."
        android:textColor="?attr/colorPrimaryDark"
        android:textStyle="bold" />


</RelativeLayout>