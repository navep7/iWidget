<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rl_widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@drawable/rounded_ss"
    android:gravity="center"
    android:orientation="vertical"
    android:theme="@style/Theme.Material3.DynamicColors.Light">

    <ImageView
        android:id="@+id/imgv_widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />


    <TextView
        android:id="@+id/tx_battery"
        android:text="Juice"
        android:background="@drawable/circular_tx_border"
        android:padding="@dimen/padding_5"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:textSize="15sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <ProgressBar
        android:id="@+id/progressBar_battery"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="100dp"
        android:layout_toEndOf="@+id/tx_battery"
        android:layout_height="wrap_content"
        android:progressTint="@android:color/darker_gray"
        android:max="100"
        android:progress="50" />


    <RelativeLayout
        android:id="@+id/rl_clocks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:paddingTop="@dimen/padding_5"
        android:paddingBottom="@dimen/padding_5">

        <ImageButton
            android:id="@+id/imgbtn_twitter"
            android:layout_below="@+id/ll_top"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/fab_margin"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:background="@android:color/transparent"
            android:scaleType="fitXY"
            android:src="@drawable/tw" />


        <LinearLayout
            android:id="@+id/ll_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/padding_5"
            android:weightSum="10"
            android:background="@drawable/thick_underline"
            android:paddingBottom="@dimen/padding_5">


            <TextView
                android:id="@+id/tx_wish"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:layout_gravity="center"
                android:text="..Greet!"
                android:layout_marginEnd="@dimen/fab_margin"
                android:gravity="center"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />


            <ImageButton
                android:id="@+id/fab_torch"
                android:layout_width="0dp"
                android:layout_height="33dp"
                android:layout_weight="1"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/circular_secondary_container"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/torch_off"
                tools:ignore="HardcodedText" />

            <ImageButton
                android:id="@+id/fab_wifi"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="33dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/circular_secondary_container"
                android:gravity="center"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/wifi_off"
                tools:ignore="HardcodedText" />


            <ImageButton
                android:id="@+id/fab_blue"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="33dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/circular_secondary_container"
                android:gravity="center"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/blue_off" />

            <TextView
                android:id="@+id/tx_reminders"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="33dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/rounded_corner_gray"
                android:gravity="center"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:text="🔔"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tx_ai"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="33dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/rounded_corner_gray"
                android:gravity="center"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:text="✨"
                tools:ignore="HardcodedText" />

        </LinearLayout>




        <RelativeLayout
            android:id="@+id/rl_clocks_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/ll_top">



            <ImageView
                android:id="@+id/imgv_texts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_glass_dark"
                android:layout_alignStart="@+id/frame_texts"
                android:layout_alignTop="@+id/frame_texts"
                android:layout_alignEnd="@+id/frame_texts"
                android:layout_alignBottom="@+id/frame_texts"
                android:scaleType="fitXY" />



            <FrameLayout
                android:id="@+id/frame_texts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/ll_steps_screentime"
                android:layout_alignParentStart="true">

                <AnalogClock
                    android:id="@+id/a_clock"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-24dp"
                    android:dial="@drawable/dialcircle"
                    android:dialTint="@android:color/transparent"
                    android:hand_hourTint="@android:color/white"
                    android:hand_minuteTint="@android:color/black"
                    android:hand_second="@drawable/s_hand"
                    android:hand_secondTint="@android:color/holo_red_light"
                    android:visibility="invisible"
                    tools:ignore="UnusedAttribute" />

                <TextView
                    android:id="@+id/tx_daychanges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                   />


                <LinearLayout
                    android:id="@+id/ll_time_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/padding_5"
                    android:paddingEnd="@dimen/padding_5">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                    <android.widget.TextClock
                        android:id="@+id/clock"
                        android:layout_marginStart="@dimen/fab_margin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm:ss"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tx_time_announcement"
                            android:layout_toRightOf="@+id/tx_weather"
                            android:text="⊘"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/holo_blue_dark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/padding_5"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tx_day_date"
                        android:layout_marginStart="@dimen/fab_margin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:text="Mon, Nov 27"
                        android:textColor="@android:color/black"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <RelativeLayout
                        android:layout_marginTop="@dimen/padding_5"
                        android:layout_marginStart="@dimen/fab_margin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tx_get_place"
                            android:text="⚲"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/holo_blue_dark"
                            android:layout_alignBaseline="@+id/tx_place"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />


                        <TextView
                            android:id="@+id/tx_place"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@+id/tx_get_place"
                            android:text="Place Information.."
                            android:layout_marginStart="@dimen/padding_5"
                            android:layout_centerVertical="true"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@android:color/black"
                            android:textSize="15sp"
                            android:textStyle="bold" />


                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_marginTop="@dimen/padding_5"
                        android:layout_marginStart="@dimen/fab_margin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">


                        <ProgressBar
                            android:id="@+id/progressBar_cyclic_weather"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_alignBottom="@+id/tx_refresh_weather"
                            android:indeterminate="true"
                            android:indeterminateTint="?attr/colorSecondary"
                            android:indeterminateTintMode="src_atop"
                            android:minWidth="5dp"
                            android:minHeight="5dp"
                            android:visibility="invisible" />


                        <TextView
                            android:id="@+id/tx_refresh_weather"
                            android:text="↺"
                            android:layout_alignBaseline="@+id/tx_weather"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/holo_blue_dark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />


                        <TextView
                            android:id="@+id/tx_weather"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@+id/tx_refresh_weather"
                            android:text="Weather Info..."
                            android:layout_marginStart="@dimen/padding_5"
                            android:layout_centerVertical="true"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@android:color/black"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/imgv_weather_icon"
                            android:background="@android:color/transparent"
                            android:layout_toRightOf="@+id/tx_weather"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:scaleType="fitXY"
                            android:layout_centerVertical="true"
                            android:src="@drawable/clouds"/>


                    </RelativeLayout>



                    <!--
                                        <RelativeLayout
                                            android:layout_marginStart="@dimen/fab_margin"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content">

                                            <TextView
                                                android:id="@+id/tx_weather_refresh"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_centerVertical="true"
                                                android:text="⟲"
                                                android:layout_alignParentStart="true"
                                                android:textSize="21sp"
                                                android:textStyle="bold" />


                                            <TextView
                                                android:id="@+id/tx_weather"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_centerVertical="true"
                                                android:text="25° C, Cloudy"
                                                android:gravity="center"
                                                android:layout_toEndOf="@+id/tx_weather_refresh"
                                                android:textColor="@android:color/black"
                                                android:textSize="15sp"
                                                android:textStyle="bold" />

                                            <ImageButton
                                                android:id="@+id/imgv_weather_icon"
                                                android:background="@android:color/transparent"
                                                android:padding="@dimen/padding_5"
                                                android:layout_toRightOf="@+id/tx_weather"
                                                android:layout_width="50dp"
                                                android:layout_height="50dp"
                                                android:layout_gravity="center_vertical"
                                                android:scaleType="fitXY"
                                                android:src="@drawable/clouds"/>





                                        </RelativeLayout>
                    -->




                </LinearLayout>

            </FrameLayout>


            <LinearLayout
                android:id="@+id/ll_steps_screentime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:paddingStart="@dimen/fab_margin"
                android:paddingEnd="@dimen/fab_margin"
                android:orientation="vertical">


                <RelativeLayout
                    android:layout_marginStart="@dimen/padding_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tx_activity_state"
                        android:textStyle="bold"
                        android:background="@drawable/gradient_glass_dark_flat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" State "/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="3dp"
                        android:layout_below="@+id/tx_activity_state"
                        android:layout_toStartOf="@+id/tx_activity_state"
                        android:layout_toEndOf="@+id/tx_activity_state"
                        android:background="@android:color/holo_blue_dark"/>


                </RelativeLayout>


                    <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageButton
                        android:id="@+id/imgv_steps"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@android:color/transparent"
                        android:scaleType="fitXY"
                        android:src="@drawable/steps" />

                    <TextView
                        android:id="@+id/tx_steps"
                        android:text="Steps, \n today"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@+id/imgv_steps"
                        android:textColor="@android:color/holo_red_light"
                        android:textSize="15sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tx_steps_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="5dp"
                        android:layout_toEndOf="@+id/tx_steps"
                        android:text="ⓘ"
                        android:textColor="@android:color/holo_blue_dark"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />


                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rl_screentime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">


                    <ImageButton
                        android:id="@+id/imgv_scr_time"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@android:color/transparent"
                        android:scaleType="fitXY"
                        android:src="@drawable/scr_time" />


                    <TextView
                        android:id="@+id/btn_screentime"
                        android:text="Screen \n Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/padding_5"
                        android:layout_toEndOf="@+id/imgv_scr_time"
                        android:background="@android:color/transparent"
                        android:textColor="@android:color/holo_red_light"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tx_screentime_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="5dp"
                        android:layout_toEndOf="@+id/btn_screentime"
                        android:text="ⓘ"
                        android:textColor="@android:color/holo_blue_dark"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />


                </RelativeLayout>

            </LinearLayout>

        </RelativeLayout>

        <ImageView
            android:id="@+id/imgv_p_album"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@+id/rl_player"
            android:layout_marginStart="@dimen/padding_5"
            android:layout_width="50dp"
            android:layout_height="50dp"/>


        <RelativeLayout
            android:id="@+id/rl_player"
            android:background="@drawable/gradient_glass_flat"
            android:layout_marginTop="@dimen/padding_5"
            android:layout_below="@+id/rl_clocks_weather"
            android:layout_toStartOf="@+id/imgv_p_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgv_player"
                android:layout_width="match_parent"
                android:layout_height="35dp"/>


            <ImageButton
                android:id="@+id/imgbtn_playpause"
                android:layout_marginStart="@dimen/padding_5"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:scaleType="fitXY"
                android:layout_marginEnd="@dimen/padding_5"
                android:layout_alignParentStart="true"
                android:backgroundTint="@android:color/holo_red_dark"
                android:src="@android:drawable/ic_media_play"/>

            <TextView
                android:id="@+id/tx_music_details"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_toEndOf="@+id/imgbtn_playpause"
                android:layout_toStartOf="@+id/imgv_p_album"
                android:layout_centerVertical="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textStyle="bold|italic"
                android:text="Play..."/>

        </RelativeLayout>



    </RelativeLayout>



    <TextView
        android:id="@+id/tx_runner"
        android:background="@drawable/circular_white"
        android:layout_below="@+id/rl_clocks"
        android:layout_marginBottom="@dimen/fab_margin"
        android:text="Pin a Note!"
        android:maxLines="1"
        android:ellipsize="middle"
        android:textStyle="bold"
        android:padding="@dimen/padding_5"
        android:textColor="@android:color/holo_red_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/tx_myspace"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="center_horizontal"
        android:layout_below="@+id/tx_runner"
        android:layout_centerHorizontal="true"
        android:background="@drawable/circular_red"
        android:gravity="center"
        android:text="User"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />



    <TextView
        android:id="@+id/tx_apps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tx_walldesc"
        android:layout_below="@+id/tx_runner"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/ll_controls"
        android:gravity="center"
        android:text="↑\nA\nP\nP\nS\n↓"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="35sp"
        android:textStyle="bold"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tx_calls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tx_walldesc"
        android:layout_below="@+id/tx_runner"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@+id/ll_controls"
        android:gravity="center"
        android:text="↑\nC\nA\nL\nL\nS\n↓"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="35sp"
        android:textStyle="bold"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/ll_apps"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:layout_above="@+id/tx_walldesc"
        android:layout_alignTop="@+id/tx_runner"
        android:layout_alignParentStart="true"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_glass_list"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgv_apps"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:scaleType="centerCrop"
                android:src="@drawable/launch_e" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Apps"
                android:textColor="@android:color/holo_red_dark"
                android:padding="@dimen/padding_5"
                android:textSize="21sp"
                android:textStyle="bold" />


        </LinearLayout>


        <ListView
            android:id="@+id/list_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false" />


    </LinearLayout>

    <ImageView
        android:id="@+id/imgv_dialler"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_alignTop="@+id/tx_myspace"
        android:layout_toStartOf="@+id/ll_contacts"
        android:background="@drawable/gradient_glass_rounded"
        android:scaleType="fitXY"
        android:src="@drawable/dial" />


    <ImageButton
        android:id="@+id/imgbtn_speech"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:padding="@dimen/padding_3"
        android:layout_above="@id/tx_walldesc"
        android:layout_toStartOf="@+id/ll_contacts"
        android:background="@drawable/gradient_glass_rounded"
        android:scaleType="fitXY"
        app:tint="@android:color/black"
        android:src="@android:drawable/ic_btn_speak_now" />


    <ImageView
        android:id="@+id/imgv_ps"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_above="@id/tx_walldesc"
        android:layout_toEndOf="@+id/ll_apps"
        android:background="@drawable/gradient_glass_rounded"
        android:scaleType="fitXY"
        android:src="@android:drawable/ic_media_play" />






    <ImageButton
        android:id="@+id/imgbtn_g_apps"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_toEndOf="@+id/ll_apps"
        android:layout_alignTop="@+id/tx_myspace"
        android:layout_marginBottom="@dimen/fab_margin"
        android:background="@drawable/gradient_glass_rounded"
        android:scaleType="centerCrop"
        android:src="@drawable/g1" />



    <LinearLayout
        android:id="@+id/ll_contacts"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tx_walldesc"
        android:layout_alignTop="@+id/tx_runner"
        android:layout_alignParentEnd="true"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_glass_list"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgv_contacts"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:scaleType="centerCrop"
                android:src="@drawable/contacts" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Calls"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="21sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgv_add_contacts"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@android:drawable/ic_input_add"
                tools:ignore="ContentDescription" />

        </LinearLayout>

        <!--
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/gradient_glass_list">

                    <ImageView
                        android:id="@+id/imgv_contacts"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginStart="@dimen/padding_5"
                        android:src="@drawable/contacts" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/padding_3"
                        android:text="Calls"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imgv_add_contacts"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@android:drawable/ic_input_add"
                        tools:ignore="ContentDescription" />

                </LinearLayout>
        -->


        <ListView
            android:id="@+id/list_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false"
            android:verticalScrollbarPosition="left" />


    </LinearLayout>




    <TextView
        android:id="@+id/widget_empty_view_contacts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/tx_walldesc"
        android:layout_below="@+id/ll_contacts"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@+id/ll_controls"
        android:background="@drawable/gradient_glass"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_empty_view_apps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/tx_walldesc"
        android:layout_below="@+id/ll_apps"
        android:layout_alignParentEnd="true"
        android:layout_toStartOf="@+id/ll_controls"
        android:background="@drawable/gradient_glass"
        android:visibility="gone" />


    <LinearLayout
        android:id="@+id/ll_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tx_walldesc"
        android:layout_below="@+id/tx_myspace"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="19dp"
        android:layout_marginLeft="@dimen/fab_margin"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginRight="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_margin"
        android:layout_toStartOf="@+id/ll_contacts"
        android:layout_toEndOf="@+id/ll_apps"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/fab_margin"
        android:paddingEnd="@dimen/fab_margin"
        android:weightSum="4">


        <ImageView
            android:id="@+id/imgv_conf"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/padding_5"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:background="@drawable/circular_tx_border"
            android:padding="@dimen/padding_5"
            android:scaleType="fitXY"
            android:src="@drawable/conf" />


        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:adjustViewBounds="true">

            <TextView
                android:id="@+id/tx_rewards_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="5"
                android:textSize="25sp"
                android:background="@drawable/gradient_glass_rounded"
                android:textColor="@android:color/holo_red_light"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />


            <ImageButton
                android:id="@+id/imgbtn_set"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:layout_marginBottom="@dimen/padding_5"
                android:adjustViewBounds="true"
                android:background="@android:color/transparent"
                android:padding="@dimen/padding_3"
                android:scaleType="fitXY"
                android:src="@android:drawable/ic_popup_sync"
                app:tint="@android:color/white" />

            <ProgressBar
                android:id="@+id/progressBar_cyclic_wallchange"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:layout_marginBottom="@dimen/padding_5"
                android:indeterminate="true"
                android:indeterminateTint="?attr/colorSecondary"
                android:indeterminateTintMode="src_atop"
                android:minWidth="5dp"
                android:minHeight="5dp"
                android:visibility="invisible" />


        </RelativeLayout>


        <ImageButton
            android:id="@+id/imgbtn_lock"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/padding_5"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:scaleType="fitXY"
            android:src="@android:drawable/ic_lock_lock"
            app:tint="@android:color/holo_red_dark" />


        <ImageView
            android:id="@+id/imgbtn_qr"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:background="@drawable/gradient_glass_flat"
            android:padding="@dimen/padding_5"
            android:src="@drawable/scan" />


    </LinearLayout>




    <TextView
        android:id="@+id/tx_walldesc"
        android:background="@drawable/gradient_glass_dark_flat"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_above="@+id/line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/line2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/tx_walltype_updateinfo"
        android:background="@android:color/black" />


    <TextView
        android:id="@+id/tx_walltype_updateinfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:autoLink="web"
        android:background="@drawable/gradient_glass_flattop"
        android:gravity="center"
        android:linksClickable="true"
        android:text="..."
        android:textColor="?attr/colorPrimaryDark"
        android:textStyle="bold" />




</RelativeLayout>