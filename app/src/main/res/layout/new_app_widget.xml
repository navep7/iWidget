             </RelativeLayout>-->


            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fab_margin"
                android:layout_marginEnd="@dimen/fab_margin">


                <AnalogClock
                    android:id="@+id/a_clock"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-24dp"
                    android:dial="@drawable/dialcircle"
                    android:dialTint="@android:color/transparent"
                    android:hand_hourTint="@android:color/white"
                    android:hand_minuteTint="@android:color/black"
                    android:hand_second="@drawable/s_hand"
                    android:hand_secondTint="@android:color/holo_red_light"
                    android:visibility="invisible"
                    tools:ignore="UnusedAttribute" />


                <LinearLayout
                    android:id="@+id/ll_time_day"
                    android:background="@drawable/rounded_ss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/fab_margin"
                    android:paddingEnd="@dimen/fab_margin">

                    <android.widget.TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:format12Hour="h:mm"
                        android:textColor="@android:color/black"
                        android:textSize="35sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tx_day_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center_horizontal"
                        android:text="Mon\n25th Nov"
                        android:textColor="@android:color/black"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />


                </LinearLayout>

            </FrameLayout>

            <FrameLayout
                android:id="@+id/rl_weather"
                android:background="@drawable/rounded_ss"
                android:layout_width="100dp"
                android:layout_height="100dp">

                <ImageView
                    android:id="@+id/weather_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/clouds" />

                <TextView
                    android:id="@+id/tx_weather_icon_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|top"
                    android:layout_marginStart="@dimen/padding_5"
                    android:text="X°C"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tx_weather_icon_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|bottom"
                    android:text="State"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </FrameLayout>


        </LinearLayout>


        <TextView
            android:id="@+id/tx_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_clocks_weather"
            android:layout_margin="@dimen/padding_3"
            android:background="@drawable/gradient_glass_flat"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text="Place"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold|italic">

            <requestFocus />
        </TextView>

    </RelativeLayout>


    <TextView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_above="@+id/frame_l_tweets"
        android:layout_below="@+id/rl_clocks"
        android:layout_marginTop="25dp"
        android:layout_toEndOf="@+id/ll_apps"
        android:background="@android:color/black" />


    <TextView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_above="@+id/frame_l_tweets"
        android:layout_below="@+id/rl_clocks"
        android:layout_marginTop="25dp"
        android:layout_toStartOf="@+id/ll_contacts"
        android:background="@android:color/black" />


    <TextView
        android:id="@+id/tx_apps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/frame_l_tweets"
        android:layout_below="@+id/rl_clocks"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/ll_controls"
        android:gravity="center"
        android:text="↑\nA\nP\nP\nS\n↓"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="35sp"
        android:textStyle="bold"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tx_calls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/frame_l_tweets"
        android:layout_below="@+id/rl_clocks"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@+id/ll_controls"
        android:gravity="center"
        android:text="↑\nC\nA\nL\nL\nS\n↓"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="35sp"
        android:textStyle="bold"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/ll_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/frame_l_tweets"
        android:layout_below="@+id/rl_clocks"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/ll_controls"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/gradient_glass_list">

            <ImageView
                android:id="@+id/imgv_apps"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="@dimen/padding_5"
                android:src="@drawable/launch_e" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/padding_5"
                android:layout_marginEnd="@dimen/padding_5"
                android:text="Apps"
                android:textSize="16sp"
                android:textStyle="bold" />


        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/black" />

        <ListView
            android:id="@+id/list_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


    </LinearLayout>


    <LinearLayout
        android:id="@+id/ll_contacts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/frame_l_tweets"
        android:layout_below="@+id/rl_clocks"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@+id/ll_controls"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/gradient_glass_list">

            <ImageView
                android:id="@+id/imgv_contacts"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="@dimen/padding_5"
                android:src="@drawable/contacts" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/padding_3"
                android:text="Calls"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgv_add_contacts"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@android:drawable/ic_input_add"
                tools:ignore="ContentDescription" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/black" />


        <ListView
            android:id="@+id/list_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


    </LinearLayout>


    <TextView
        android:id="@+id/widget_empty_view_contacts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/frame_l_tweets"
        android:layout_below="@+id/ll_contacts"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@+id/ll_controls"
        android:background="@drawable/gradient_glass"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_empty_view_apps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/frame_l_tweets"
        android:layout_below="@+id/ll_apps"
        android:layout_alignParentEnd="true"
        android:layout_toStartOf="@+id/ll_controls"
        android:background="@drawable/gradient_glass"
        android:visibility="gone" />


    <LinearLayout
        android:id="@+id/ll_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_clocks"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/padding_5"
        android:layout_marginEnd="@dimen/padding_5"
        android:orientation="vertical"
        android:padding="@dimen/padding_5"
        android:paddingStart="@dimen/fab_margin"
        android:paddingEnd="@dimen/fab_margin">


        <LinearLayout
            android:id="@+id/ll_controls1"
            android:layout_width="wrap_content"
            android:layout_height="50dp">

            <ImageButton
                android:id="@+id/imgbtn_location"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/circular_border"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/location" />

            <ImageButton
                android:id="@+id/imgbtn_conf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/circular_border"
                android:padding="@dimen/padding_5"
                android:src="@android:drawable/ic_menu_search" />


            <ImageButton
                android:id="@+id/imgbtn_speech"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/circular_border"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@android:drawable/ic_btn_speak_now" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_controls2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">


            <ImageButton
                android:id="@+id/imgbtn_lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/circular_border"
                android:padding="@dimen/padding_5"
                android:src="@android:drawable/ic_lock_lock" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/imgbtn_set"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/circular_border"
                    android:padding="@dimen/padding_5"
                    android:src="@android:drawable/ic_popup_sync" />

                <ProgressBar
                    android:id="@+id/progressBar_cyclic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/colorSecondary"
                    android:indeterminateTintMode="src_atop"
                    android:minWidth="25dp"
                    android:minHeight="25dp"
                    android:visibility="invisible" />


                <TextView
                    android:id="@+id/tx_rewards_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gradient_glass_flatbottom"
                    android:text="5"
                    android:textColor="@android:color/holo_red_light"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

            </RelativeLayout>


        </LinearLayout>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/ll_gapps_napps"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_below="@+id/ll_controls"
        android:layout_alignStart="@+id/ll_controls"
        android:layout_alignEnd="@+id/ll_controls"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:weightSum="3">

        <ImageButton
            android:id="@+id/imgbtn_g_apps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="G"
            android:scaleType="fitCenter"
            android:src="@drawable/g1"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/fab_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:background="@drawable/dial_c"
            android:contentDescription="G"
            android:padding="@dimen/fab_margin"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_share"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/imgbtn_n_apps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="G"
            android:scaleType="fitCenter"
            android:src="@drawable/s1"
            tools:ignore="HardcodedText" />

    </LinearLayout>


    <ImageView
        android:id="@+id/imgbtn_qr"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_below="@+id/ll_gapps_napps"
        android:layout_centerHorizontal="true"
        android:background="@drawable/circular_primary_border"
        android:src="@drawable/scan" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_gapps_napps"
        android:layout_marginTop="30dp"
        android:layout_toStartOf="@+id/imgbtn_qr"
        android:background="@drawable/gradient_glass_dark"
        android:paddingStart="@dimen/padding_5"
        android:paddingEnd="@dimen/padding_5"
        android:text="SCAN"
        android:textColor="@android:color/white"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_gapps_napps"
        android:layout_marginTop="30dp"
        android:layout_toEndOf="@+id/imgbtn_qr"
        android:background="@drawable/gradient_glass_dark"
        android:paddingStart="@dimen/padding_5"
        android:paddingEnd="@dimen/padding_5"
        android:text="PAY"
        android:textColor="@android:color/white"
        android:textStyle="bold" />


    <ImageView
        android:id="@+id/imgv_dialler"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_above="@+id/frame_l_tweets"
        android:layout_margin="@dimen/fab_margin"
        android:layout_toStartOf="@+id/ll_contacts"
        android:background="@drawable/bg_gradient_glass_rounded"
        android:scaleType="fitXY"
        android:src="@drawable/dial" />


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:background="@drawable/gradient_glass_rounded"
        android:visibility="gone">

        <TextView
            android:id="@+id/tx_sname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:text="Song name.." />

        <ImageButton
            android:id="@+id/imgbtn_media_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/tx_sname"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous" />


        <ImageButton
            android:id="@+id/imgbtn_media_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/imgbtn_media_prev"
            android:background="@drawable/gradient_glass_rounded"
            android:src="@android:drawable/ic_media_play" />


        <ImageButton
            android:id="@+id/imgbtn_media_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/imgbtn_media_play_pause"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_next" />


    </RelativeLayout>


    <FrameLayout
        android:id="@+id/frame_l_tweets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tx_desc_walltype"
        android:foregroundGravity="center">


        <TextView
            android:id="@+id/tx_tweets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:autoLink="all"
            android:background="#80FFFFFF"
            android:ellipsize="end"
            android:gravity="center"
            android:linksClickable="true"
            android:maxLines="2"
            android:text="Tweets"
            android:textColor="?attr/colorPrimaryDark"
            android:textSize="15sp"
            android:textStyle="bold" />


        <ImageButton
            android:id="@+id/twSettings"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginStart="-7dp"
            android:layout_marginTop="-7dp"
            android:background="@android:color/transparent"
            android:scaleType="fitXY"
            android:src="@drawable/tw" />

    </FrameLayout>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/frame_l_tweets"
        android:background="@android:color/black" />

    <TextView
        android:id="@+id/tx_desc_walltype"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:autoLink="web"
        android:background="@drawable/gradient_glass_flattop"
        android:gravity="center"
        android:linksClickable="true"
        android:text="..."
        android:textColor="?attr/colorPrimaryDark"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/tx_desc_walltype"
        android:background="@android:color/black" />


</RelativeLayout>