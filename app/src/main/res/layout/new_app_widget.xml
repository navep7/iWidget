<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rl_widget_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="vertical"
    android:theme="@style/Theme.Material3.DynamicColors.Light">


    <ImageView
        android:id="@+id/imgv_widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <RelativeLayout
        android:id="@+id/rl_clocks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:paddingBottom="@dimen/padding_5">


        <LinearLayout
            android:id="@+id/ll_top"
            android:weightSum="10"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/gradient_glass_flatbottom"
            android:padding="@dimen/padding_7">


            <RelativeLayout
                android:id="@+id/rl_battery"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/padding_5"
                android:layout_height="match_parent"
                android:gravity="center">

                <ProgressBar
                    android:id="@+id/progressBar_battery"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_centerVertical="true"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="75"
                    android:progressDrawable="@drawable/circular_progress_drawable" />

                <TextView
                    android:id="@+id/tx_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡"
                    android:layout_centerInParent="true"
                    android:tag="⚡"
                    android:textColor="@android:color/black"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>


            <TextView
                android:id="@+id/tx_wish"
                android:text="..Greet!"
                android:layout_marginStart="@dimen/padding_3"
                android:gravity="center"
                android:layout_weight="4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:textColor="@android:color/black"
                android:textSize="25sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />


            <ImageButton
                android:id="@+id/imgbtn_reminders"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/padding_3"
                android:background="@drawable/rounded_corner_gray"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/bell_hr"
                app:tint="@android:color/darker_gray"
                tools:ignore="HardcodedText" />


            <ImageButton
                android:id="@+id/fab_torch"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/padding_3"
                android:background="@drawable/rounded_corner_gray"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/torch_off"
                tools:ignore="HardcodedText" />

            <ImageButton
                android:id="@+id/fab_wifi"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/padding_3"
                android:background="@drawable/rounded_corner_gray"
                android:gravity="center"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/wifi_off"
                tools:ignore="HardcodedText" />


            <ImageButton
                android:id="@+id/fab_blue"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/padding_3"
                android:layout_height="match_parent"
                android:background="@drawable/rounded_corner_gray"
                android:gravity="center"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/blue_off" />

            <ImageButton
                android:id="@+id/fab_ai"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/padding_3"
                android:layout_marginEnd="@dimen/padding_5"
                android:layout_height="match_parent"
                android:background="@drawable/rounded_corner_gray"
                android:gravity="center"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/ai" />

        </LinearLayout>




        <RelativeLayout
            android:id="@+id/rl_clocks_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/ll_top"
            android:background="@drawable/gradient_glass_dark">

            <LinearLayout
                android:id="@+id/ll_place"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="@dimen/padding_5"
                android:layout_margin="@dimen/padding_5"
                android:layout_alignBottom="@+id/frame_texts"
                android:layout_toStartOf="@+id/frame_texts"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tx_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Place Information"
                    android:layout_gravity="start"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageButton
                        android:id="@+id/imgv_map_icon"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/padding_5"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@android:color/transparent"
                        android:scaleType="fitXY"
                        android:src="@drawable/map_logo" />


                    <TextView
                        android:id="@+id/tx_open_maps"
                        android:layout_gravity="top|center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-5dp"
                        android:text="⚲"
                        android:textColor="@android:color/holo_green_light"
                        android:textSize="25sp"
                        android:textStyle="bold" />


                </FrameLayout>


            </LinearLayout>

            <AnalogClock
                android:id="@+id/a_clock"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="-25dp"
                android:layout_marginBottom="-25dp"
                android:layout_centerHorizontal="true"
                android:dial="@drawable/dial_transparent"
                android:dialTint="@color/alpha_primary_color"
                android:hand_second="@drawable/s_hand"
                android:hand_minuteTint="@android:color/holo_green_light"
                android:hand_hourTint="@android:color/holo_orange_light"
                android:hand_secondTint="@android:color/holo_red_dark"
                android:visibility="visible"
                tools:ignore="UnusedAttribute" />




            <FrameLayout
                android:id="@+id/frame_texts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">



                <LinearLayout
                    android:id="@+id/ll_time_day"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/padding_3"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_5">


                    <TextView
                        android:id="@+id/tx_time_announcement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="⊘"
                        android:textColor="@android:color/holo_green_light"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tx_day_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="Fri, 13th Apr"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <android.widget.TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="25dp"
                        android:layout_marginStart="@dimen/padding_5"
                        android:layout_marginEnd="@dimen/padding_5"
                        android:format12Hour="h:mm:ss"
                        android:textColor="@android:color/holo_red_light"
                        android:textSize="35sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </FrameLayout>


<!--
                        <LinearLayout
                            android:id="@+id/ll_weather"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="@dimen/fab_margin"
