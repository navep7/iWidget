                 android:background="@drawable/gradient_glass_rounded">


                 <ImageButton
                     android:id="@+id/n_imgv_steps"
                     android:layout_width="25dp"
                     android:layout_height="25dp"
                     android:layout_centerVertical="true"
                     android:layout_alignParentStart="true"
                     android:background="@android:color/transparent"
                     android:scaleType="fitXY"
                     android:src="@drawable/steps" />

                 <TextView
                     android:id="@+id/n_tx_steps_now"
                     android:text="Now ~ "
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:layout_centerVertical="true"
                     android:layout_marginStart="5dp"
                     android:layout_toEndOf="@+id/n_imgv_steps"
                     android:textColor="@android:color/holo_red_light"
                     android:textSize="15sp"
                     android:textStyle="bold"
                     tools:ignore="HardcodedText" />


                 <TextView
                     android:id="@+id/n_tx_steps"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:layout_centerVertical="true"
                     android:layout_marginStart="5dp"
                     android:layout_toEndOf="@+id/n_tx_steps_now"
                     android:textColor="@android:color/holo_red_light"
