<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rl_widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@drawable/gradient_glass_rounded_ss"
    android:gravity="center"
    android:orientation="vertical"
    android:theme="@style/Theme.Material3.DynamicColors.Light">


    <RelativeLayout
        android:id="@+id/rl_clocks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true">

        <LinearLayout
            android:id="@+id/ll_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/padding_5"
            android:background="@drawable/thick_underline"
            android:paddingBottom="@dimen/padding_5">

            <TextView
                android:id="@+id/tx_wish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="..Greeting!"
                android:textColor="?attr/colorTertiary"
                android:textSize="33sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />


            <ImageButton
                android:id="@+id/fab_torch"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/circular_secondary_container"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/torch_off"
                tools:ignore="HardcodedText" />

            <ImageButton
                android:id="@+id/fab_wifi"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/circular_secondary_container"
                android:gravity="center"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/wifi_off"
                tools:ignore="HardcodedText" />


            <ImageButton
                android:id="@+id/fab_blue"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/circular_secondary_container"
                android:gravity="center"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:src="@drawable/blue_off" />

            <TextView
                android:id="@+id/tx_reminders"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/rounded_corner_gray"
                android:gravity="center"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:text="🔔"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tx_ai"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/rounded_corner_gray"
                android:gravity="center"
                android:padding="@dimen/padding_5"
                android:scaleType="fitXY"
                android:text="✨"
                tools:ignore="HardcodedText" />

        </LinearLayout>


        <!-- <ImageButton
             android:id="@+id/fab_camera"
             android:layout_width="35dp"
             android:layout_height="35dp"
             android:layout_alignParentTop="true"
             android:layout_marginTop="5dp"
             android:layout_marginStart="3dp"
             android:layout_toEndOf="@+id/fab_settings"
             android:background="@drawable/weather_rounded_corner"
             android:gravity="center"
             android:padding="5dp"
             android:scaleType="fitXY"
             android:src="@android:drawable/ic_menu_camera"
             tools:ignore="HardcodedText" />

         <ImageButton
             android:id="@+id/fab_settings"
             android:layout_width="35dp"
             android:layout_height="35dp"
             android:layout_alignParentTop="true"
             android:layout_marginTop="5dp"
             android:layout_marginStart="3dp"
             android:layout_toEndOf="@+id/fab_torch"
             android:background="@drawable/weather_rounded_corner"
             android:gravity="center"
             android:padding="5dp"
             android:scaleType="fitXY"
             android:src="@drawable/settings"
             tools:ignore="HardcodedText" />-->


        <TextView
            android:id="@+id/tx_live_weather_effects"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_below="@+id/ll_top"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="25dp"
            android:layout_marginEnd="50dp"
            android:gravity="center"
            android:scaleType="fitXY"
            android:text="☄"
            android:textSize="35sp"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/ll_clocks_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_glass_dark_flat"
            android:layout_below="@id/ll_top"
            android:gravity="center">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:background="@drawable/rounded_ss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageButton
                        android:id="@+id/imgv_steps"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@android:color/transparent"
                        android:scaleType="fitXY"
                        android:src="@drawable/steps" />

                    <TextView
                        android:id="@+id/tx_steps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@+id/imgv_steps"
                        android:text="Xx"
                        android:textColor="@android:color/holo_red_light"
                        android:textSize="15sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tx_steps_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="5dp"
                        android:layout_toEndOf="@+id/tx_steps"
                        android:text="ⓘ"
                        android:textColor="@color/white"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />


                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rl_screentime"
                    android:background="@drawable/rounded_ss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fab_margin">


                    <ImageButton
                        android:id="@+id/imgv_scr_time"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@android:color/transparent"
                        android:scaleType="fitXY"
                        android:src="@drawable/scr_time" />


                    <TextView
                        android:id="@+id/btn_screentime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/padding_5"
                        android:layout_toEndOf="@+id/imgv_scr_time"
                        android:background="@android:color/transparent"
                        android:text="10+ H"
                        android:textColor="@android:color/holo_red_light"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tx_screentime_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="5dp"
                        android:layout_toEndOf="@+id/btn_screentime"
                        android:text="ⓘ"
                        android:textColor="@android:color/white"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />


                </RelativeLayout>

            </LinearLayout>
            <!-- <ImageButton
                 android:id="@+id/imgbtn_steps_newlap"
                 android:visibility="gone"
                 android:src="@android:drawable/ic_input_add"
                 android:layout_marginStart="@dimen/padding_3"
                 android:background="@android:color/transparent"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"/>

             <RelativeLayout
                 android:id="@+id/rl_n_steps"
                 android:layout_width="wrap_content"
                 android:layout_height="35dp"
