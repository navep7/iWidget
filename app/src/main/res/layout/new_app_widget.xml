<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rl_widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:layout_gravity="center"
    android:background="@drawable/gradient_glass"
    android:orientation="vertical"
    android:theme="@style/Theme.Material3.DynamicColors.Light">


    <RelativeLayout
        android:id="@+id/rl_clocks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/gradient_glass_flatbottom">

        <TextView
            android:id="@+id/tx_wish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_gravity="center"

            android:text="a Wish..."
            android:textColor="?attr/colorPrimaryDark"
            android:textSize="33sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tx_ai"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="5dp"
            android:background="@drawable/rounded_corner_gray"
            android:gravity="center"
            android:padding="5dp"
            android:scaleType="fitXY"
            android:text="✨"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/fab_blue"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentTop="true"
            android:layout_margin="5dp"
            android:layout_toStartOf="@+id/tx_ai"
            android:background="@drawable/weather_rounded_corner"
            android:gravity="center"
            android:padding="5dp"
            android:scaleType="fitXY"
            android:src="@drawable/blue_off"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tx_reminders"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentTop="true"
            android:layout_margin="5dp"
            android:layout_toStartOf="@+id/fab_blue"
            android:background="@drawable/rounded_corner_gray"
            android:gravity="center"
            android:padding="5dp"
            android:scaleType="fitXY"
            android:text="🔔"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/fab_wifi"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentTop="true"
            android:layout_margin="5dp"
            android:layout_toStartOf="@+id/tx_reminders"
            android:background="@drawable/weather_rounded_corner"
            android:gravity="center"
            android:padding="5dp"
            android:scaleType="fitXY"
            android:src="@drawable/wifi_off"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/fab_torch"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentTop="true"
            android:layout_marginTop="5dp"
            android:layout_toEndOf="@+id/tx_wish"
            android:background="@drawable/weather_rounded_corner"
            android:gravity="center"
            android:padding="5dp"
            android:scaleType="fitXY"
            android:src="@drawable/torch_off"
            tools:ignore="HardcodedText" />

       <!-- <ImageButton
            android:id="@+id/fab_camera"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentTop="true"
            android:layout_marginTop="5dp"
            android:layout_marginStart="3dp"
            android:layout_toEndOf="@+id/fab_settings"
            android:background="@drawable/weather_rounded_corner"
            android:gravity="center"
            android:padding="5dp"
            android:scaleType="fitXY"
            android:src="@android:drawable/ic_menu_camera"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/fab_settings"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentTop="true"
            android:layout_marginTop="5dp"
            android:layout_marginStart="3dp"
            android:layout_toEndOf="@+id/fab_torch"
            android:background="@drawable/weather_rounded_corner"
            android:gravity="center"
            android:padding="5dp"
            android:scaleType="fitXY"
            android:src="@drawable/settings"
            tools:ignore="HardcodedText" />-->


        <TextView
            android:id="@+id/tx_weather_icon_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/weather_icon"
            android:layout_marginBottom="-45dp"
            android:layout_alignEnd="@+id/weather_icon"
            android:background="@drawable/gradient_glass"
            android:scaleType="fitXY"
            android:text="25°C"
            android:textColor="?attr/colorTertiary"
            android:textSize="25dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tx_weather_icon_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/weather_icon"
            android:layout_marginBottom="-20dp"
            android:layout_alignStart="@+id/weather_icon"
            android:background="@drawable/gradient_glass"
            android:scaleType="fitXY"
            android:text="State..,"
            android:textColor="?attr/colorTertiary"
            android:textStyle="bold" />


        <ImageButton
            android:id="@+id/weather_icon"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_below="@+id/tx_wish"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/fab_margin"
            android:layout_marginEnd="5dp"
            android:background="@drawable/weather_rounded_corner"
            android:scaleType="fitXY"
            android:src="@drawable/clouds" />

        <ImageView
            android:id="@+id/animation_image"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_below="@+id/tx_wish"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/fab_margin"
            android:layout_marginEnd="5dp"
            android:scaleType="fitXY" />


        <TextView
            android:id="@+id/tx_ref_weather_icon"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_below="@+id/tx_wish"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/fab_margin"
            android:layout_marginEnd="5dp"
            android:scaleType="fitXY"
            android:gravity="center"
            android:textSize="50sp"
            android:text="↻" />


        <AnalogClock
            android:id="@+id/a_clock"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_above="@+id/tx_place"
            android:layout_below="@+id/tx_wish"
            android:dial="@drawable/walp_icon"
            android:hand_second="@drawable/s_hand" />

        <android.widget.TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tx_wish"
            android:layout_toEndOf="@+id/a_clock"
            android:format24Hour="k:mm:ss"
            android:textColor="?attr/colorPrimaryDark"
            android:textSize="35sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tx_day_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/clock"
            android:layout_marginEnd="@dimen/fab_margin"
            android:layout_toEndOf="@+id/a_clock"
            android:text="Day│Date"
            android:textColor="?attr/colorPrimaryDark"
            android:textSize="25sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />


        <TextView
            android:id="@+id/tx_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tx_day_date"
            android:layout_marginStart="@dimen/fab_margin"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text="Place"
            android:textColor="?attr/colorPrimaryDark"
            android:textSize="15sp"
            android:textStyle="bold">

            <requestFocus />
        </TextView>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_news"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_below="@+id/rl_clocks"
        android:layout_marginTop="3dp"
        android:background="#80FFFFFF"
        android:visibility="invisible">


        <ImageView
            android:id="@+id/imgv_news"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/tx_news"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_toLeftOf="@+id/imgbtn_news_prev"
            android:layout_toRightOf="@+id/imgv_news"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textSize="15sp"
            android:textStyle="bold" />


        <ImageButton
            android:id="@+id/imgbtn_news_prev"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_toStartOf="@+id/imgbtn_news_next"
            android:background="@android:color/transparent"
            android:foregroundGravity="center"
            android:src="@android:drawable/ic_media_previous" />


        <ImageButton
            android:id="@+id/imgbtn_news_next"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:background="@android:color/transparent"
            android:foregroundGravity="center"
            android:src="@android:drawable/ic_media_next" />

    </RelativeLayout>

    <RelativeLayout
