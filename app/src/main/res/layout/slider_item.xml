<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/image_view_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <RelativeLayout
        android:id="@+id/rl_widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/rounded_ss"
        android:gravity="center"
        android:orientation="vertical"
        android:theme="@style/Theme.Material3.DynamicColors.Light">

        <ImageView
            android:id="@+id/imgv_widget_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />

        <RelativeLayout
            android:id="@+id/rl_clocks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:padding="@dimen/fab_margin">

            <LinearLayout
                android:id="@+id/ll_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/padding_5"
                android:background="@drawable/thick_underline"
                android:paddingBottom="@dimen/padding_5"
                android:weightSum="10">

                <TextView
                    android:id="@+id/tx_wish"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="5"
                    android:text="..Welcome!"
                    android:textColor="@android:color/holo_red_light"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />


                <ImageButton
                    android:id="@+id/fab_torch"
                    android:layout_width="0dp"
                    android:layout_height="33dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/circular_secondary_container"
                    android:padding="@dimen/padding_5"
                    android:scaleType="fitXY"
                    android:src="@drawable/torch_off"
                    tools:ignore="HardcodedText" />

                <ImageButton
                    android:id="@+id/fab_wifi"
                    android:layout_width="0dp"
                    android:layout_height="33dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/circular_secondary_container"
                    android:gravity="center"
                    android:padding="@dimen/padding_5"
                    android:scaleType="fitXY"
                    android:src="@drawable/wifi_off"
                    tools:ignore="HardcodedText" />


                <ImageButton
                    android:id="@+id/fab_blue"
                    android:layout_width="0dp"
                    android:layout_height="33dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/circular_secondary_container"
                    android:gravity="center"
                    android:padding="@dimen/padding_5"
                    android:scaleType="fitXY"
                    android:src="@drawable/blue_off" />

                <TextView
                    android:id="@+id/tx_reminders"
                    android:layout_width="0dp"
                    android:layout_height="33dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_corner_gray"
                    android:gravity="center"
                    android:padding="@dimen/padding_5"
                    android:scaleType="fitXY"
                    android:text="🔔"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tx_ai"
                    android:layout_width="0dp"
                    android:layout_height="33dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_corner_gray"
                    android:gravity="center"
                    android:padding="@dimen/padding_5"
                    android:scaleType="fitXY"
                    android:text="✨"
                    tools:ignore="HardcodedText" />

            </LinearLayout>


            <RelativeLayout
                android:id="@+id/rl_clocks_weather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/ll_top">

                <ImageView
                    android:id="@+id/imgv_texts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignStart="@+id/frame_texts"
                    android:layout_alignTop="@+id/frame_texts"
                    android:layout_alignEnd="@+id/frame_texts"
                    android:layout_alignBottom="@+id/frame_texts"
                    android:layout_margin="3dp"
                    android:scaleType="fitXY" />


                <FrameLayout
                    android:id="@+id/frame_texts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/fab_margin"
                    android:layout_toStartOf="@+id/ll_steps_screentime"
                    android:background="@drawable/gradient_glass_rounded">

                    <AnalogClock
                        android:id="@+id/a_clock"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="-24dp"
                        android:dial="@drawable/dialcircle"
                        android:dialTint="@android:color/transparent"
                        android:hand_hourTint="@android:color/white"
                        android:hand_minuteTint="@android:color/black"
                        android:hand_second="@drawable/s_hand"
                        android:hand_secondTint="@android:color/holo_red_light"
                        android:visibility="invisible"
                        tools:ignore="UnusedAttribute" />


                    <LinearLayout
                        android:id="@+id/ll_time_day"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/padding_5"
                        android:paddingEnd="@dimen/padding_5">


                        <android.widget.TextClock
                            android:id="@+id/clock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/fab_margin"
                            android:format12Hour="h:mm:ss"
                            android:textColor="@android:color/black"
                            android:textSize="25sp"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/tx_day_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/fab_margin"
                            android:gravity="center_horizontal"
                            android:text="Day, Date"
                            android:textColor="@android:color/black"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/fab_margin"
                            android:layout_marginTop="@dimen/padding_5">

                            <TextView
                                android:id="@+id/tx_get_place"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:scaleType="fitXY"
                                android:src="@drawable/clouds"
                                android:text="⚲ "
                                android:textColor="@android:color/holo_red_light"
                                android:textStyle="bold" />


                            <TextView
                                android:id="@+id/tx_place"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_toEndOf="@+id/tx_get_place"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="② Place Info..."
                                android:textColor="@android:color/black"
                                android:textSize="15sp"
                                android:textStyle="bold" />


                        </RelativeLayout>


                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/fab_margin"
                            android:layout_marginBottom="@dimen/fab_margin">

                            <ImageButton
                                android:id="@+id/imgv_weather_icon"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_gravity="center_vertical"
                                android:background="@android:color/transparent"
                                android:scaleType="fitXY"
                                android:src="@drawable/clouds" />

                            <TextView
                                android:id="@+id/tx_weather"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_toEndOf="@+id/imgv_weather_icon"
                                android:text="Weather Data"
                                android:textColor="@android:color/black"
                                android:textSize="15sp"
                                android:textStyle="bold" />


                        </RelativeLayout>


                    </LinearLayout>

                </FrameLayout>


                <LinearLayout
                    android:id="@+id/ll_steps_screentime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageButton
                            android:id="@+id/imgv_steps"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="@android:color/transparent"
                            android:scaleType="fitXY"
                            android:src="@drawable/steps" />

                        <TextView
                            android:id="@+id/tx_steps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/imgv_steps"
                            android:text="① StepsCount  "
                            android:textColor="@android:color/holo_red_light"
                            android:textSize="15sp"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/tx_steps_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/tx_steps"
                            android:text="ⓘ"
                            android:textColor="@android:color/holo_red_dark"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />


                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rl_screentime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">


                        <ImageButton
                            android:id="@+id/imgv_scr_time"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="@android:color/transparent"
                            android:scaleType="fitXY"
                            android:src="@drawable/scr_time" />


                        <TextView
                            android:id="@+id/btn_screentime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/imgv_scr_time"
                            android:background="@android:color/transparent"
                            android:text="ScreenTime\nin Hours"
                            android:textColor="@android:color/holo_red_light"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tx_screentime_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="5dp"
                            android:layout_toEndOf="@+id/btn_screentime"
                            android:text="ⓘ"
                            android:textColor="@android:color/holo_red_dark"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />


                    </RelativeLayout>

                </LinearLayout>


            </RelativeLayout>


        </RelativeLayout>


        <TextView
            android:id="@+id/tx_apps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/frame_l_tweets"
            android:layout_below="@+id/rl_clocks"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/ll_controls"
            android:gravity="center"
            android:text="↑\nA\nP\nP\nS\n↓"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="35sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/tx_calls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/frame_l_tweets"
            android:layout_below="@+id/rl_clocks"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@+id/ll_controls"
            android:gravity="center"
            android:text="↑\nC\nA\nL\nL\nS\n↓"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="35sp"
            android:textStyle="bold"
            android:visibility="invisible" />


        <ImageView
            android:id="@+id/imgv_dialler"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_above="@+id/ll_contacts"
            android:layout_alignParentEnd="true"
            android:background="@drawable/gradient_glass_rounded"
            android:scaleType="fitXY"
            android:src="@drawable/dial" />

        <ImageButton
            android:id="@+id/imgbtn_speech"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_below="@+id/rl_clocks"
            android:layout_alignStart="@+id/ll_contacts"
            android:background="@drawable/gradient_glass_rounded"
            android:padding="@dimen/padding_3"
            android:scaleType="fitXY"
            android:src="@android:drawable/ic_btn_speak_now"
            app:tint="@android:color/black" />


        <ImageView
            android:id="@+id/imgv_ps"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignBottom="@+id/imgbtn_g_apps"
            android:layout_alignParentStart="true"
            android:background="@drawable/gradient_glass_rounded"
            android:scaleType="fitXY"
            android:src="@android:drawable/ic_media_play" />

        <ImageButton
            android:id="@+id/imgbtn_g_apps"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_below="@+id/rl_clocks"
            android:layout_alignEnd="@+id/ll_apps"
            android:background="@drawable/gradient_glass_rounded"
            android:scaleType="centerCrop"
            android:src="@drawable/g1" />

        <LinearLayout
            android:id="@+id/ll_apps"
            android:layout_width="125dp"
            android:layout_height="match_parent"
            android:layout_above="@+id/frame_l_tweets"
            android:layout_below="@+id/imgbtn_speech"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/gradient_glass_list">

                <ImageView
                    android:id="@+id/imgv_apps"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="@dimen/padding_5"
                    android:src="@drawable/launch_e" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/padding_3"
                    android:text="③ Apps\nMost Used"
                    android:textSize="10sp"
                    android:textStyle="bold" />


            </LinearLayout>


            <RelativeLayout
                android:layout_marginTop="@dimen/fab_margin"
                android:gravity="top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/app_imgv"
                    android:src="@drawable/launch_e"
                    android:layout_centerInParent="true"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/app_tx"
                    android:text="AppName"
                    android:background="@drawable/gradient_glass_flat"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_below="@+id/app_imgv"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/contacts"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/app_usage_time"
                    android:text="Usage,\nMins/Day"
                    android:textColor="@android:color/holo_red_dark"
                    android:textSize="10sp"
                    android:layout_toEndOf="@+id/app_imgv"
                    android:layout_marginStart="-50dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:background="@drawable/circular_white"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_alignParentTop="true"
                    android:src="@drawable/contacts"
                    tools:ignore="HardcodedText" />

            </RelativeLayout>

            <TextView
                android:text="|\n↓"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="@dimen/fab_margin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>



        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_contacts"
            android:layout_width="125dp"
            android:layout_height="match_parent"
            android:layout_above="@+id/frame_l_tweets"
            android:layout_below="@+id/imgbtn_speech"
            android:layout_alignParentEnd="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/gradient_glass_list">

                <ImageView
                    android:id="@+id/imgv_contacts"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="@dimen/padding_5"
                    android:src="@drawable/contacts" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/padding_3"
                    android:text="Calls\n④ Fav Contacts"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgv_add_contacts"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="@dimen/padding_5"
                    android:src="@android:drawable/ic_input_add" />



            </LinearLayout>


            <RelativeLayout
                android:layout_marginTop="@dimen/fab_margin"
                android:layout_width="match_parent"
                android:layout_height="100dp">

                <ImageView
                    android:id="@+id/c_imgv"
                    android:src="@drawable/contacts"
                    android:layout_above="@+id/c_tx"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/c_tx"
                    android:text="ContactName"
                    android:background="@drawable/gradient_glass_flat"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/contacts"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/c_close"
                    android:text=" X "
                    android:textColor="@android:color/holo_red_dark"
                    android:textSize="10sp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:background="@drawable/circular_white"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginEnd="@dimen/fab_margin"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:src="@drawable/contacts"
                    tools:ignore="HardcodedText" />

            </RelativeLayout>

            <TextView
                android:text="|\n↓"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="@dimen/fab_margin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>



        </LinearLayout>


        <TextView
            android:id="@+id/widget_empty_view_contacts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/frame_l_tweets"
            android:layout_below="@+id/ll_contacts"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@+id/ll_controls"
            android:background="@drawable/gradient_glass"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_empty_view_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/frame_l_tweets"
            android:layout_below="@+id/ll_apps"
            android:layout_alignParentEnd="true"
            android:layout_toStartOf="@+id/ll_controls"
            android:background="@drawable/gradient_glass"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tx_rewards_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/ll_controls"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="-13dp"
            android:background="@drawable/gradient_glass_flatbottom"
            android:text="5"
            android:textColor="@android:color/holo_red_light"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />


        <LinearLayout
            android:id="@+id/ll_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_clocks"
            android:layout_centerHorizontal="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/padding_5"
            android:paddingStart="@dimen/fab_margin"
            android:paddingEnd="@dimen/fab_margin">


            <LinearLayout
                android:id="@+id/ll_controls1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">


                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/imgbtn_setd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/circular_red"
                        android:src="@android:drawable/ic_popup_sync" />

                    <ProgressBar
                        android:id="@+id/progressBar_cyclic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:indeterminate="true"
                        android:indeterminateTint="?attr/colorSecondary"
                        android:indeterminateTintMode="src_atop"
                        android:minWidth="25dp"
                        android:minHeight="25dp"
                        android:visibility="invisible" />


                </RelativeLayout>


            </LinearLayout>

            <ImageButton
                android:id="@+id/imgbtn_set"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/rounded_ss"
                android:padding="@dimen/padding_3"
                android:src="@android:drawable/ic_popup_sync"
                app:tint="@android:color/white" />


            <ImageButton
                android:id="@+id/imgbtn_lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/fab_margin"
                android:background="@drawable/rounded_ss"
                android:padding="@dimen/padding_5"
                android:src="@android:drawable/ic_lock_lock"
                app:tint="@android:color/holo_red_dark" />

            <TextView
                android:id="@+id/tx_myspace"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:background="@drawable/rounded_ss"
                android:gravity="center"
                android:text="User\nSpace"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ImageView
            android:id="@+id/imgbtn_qr"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_above="@+id/frame_l_tweets"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/padding_5"
            android:background="@drawable/circular_primary_border"
            android:src="@drawable/qr" />

        <FrameLayout
            android:id="@+id/frame_l_tweets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/tx_walltype_updateinfo"
            android:foregroundGravity="center">


            <TextView
                android:id="@+id/tx_tweets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:autoLink="all"
                android:background="#80FFFFFF"
                android:ellipsize="end"
                android:gravity="center"
                android:linksClickable="true"
                android:maxLines="2"
                android:text="Tweets"
                android:textColor="?attr/colorPrimaryDark"
                android:textSize="15sp"
                android:textStyle="bold" />


            <ImageButton
                android:id="@+id/twSettings"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginStart="-7dp"
                android:layout_marginTop="-7dp"
                android:background="@android:color/transparent"
                android:scaleType="fitXY"
                android:src="@drawable/tw" />

        </FrameLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/frame_l_tweets"
            android:background="@android:color/black" />

        <TextView
            android:id="@+id/tx_walltype_updateinfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:autoLink="web"
            android:background="@drawable/gradient_glass_flattop"
            android:gravity="center"
            android:linksClickable="true"
            android:text="..."
            android:textColor="?attr/colorPrimaryDark"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/tx_walltype_updateinfo"
            android:background="@android:color/black" />


    </RelativeLayout>
</RelativeLayout>