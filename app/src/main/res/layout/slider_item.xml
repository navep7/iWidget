<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/image_view_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <RelativeLayout
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/rl_widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:layout_gravity="center"
        android:background="@drawable/gradient_glass"
        android:orientation="vertical"
        android:theme="@style/Theme.Material3.DynamicColors.Light">


        <RelativeLayout
            android:id="@+id/rl_clocks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/gradient_glass_flatbottom">


            <LinearLayout
                android:id="@+id/ll_top"
                android:layout_alignParentTop="true"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tx_wish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="..Greeting!"
                android:layout_marginEnd="5dp"
                android:textColor="?attr/colorPrimaryDark"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <ImageButton
                android:id="@+id/fab_torch"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/weather_rounded_corner"
                android:gravity="center"
                android:padding="5dp"
                android:scaleType="fitXY"
                android:src="@drawable/torch_off"
                tools:ignore="HardcodedText" />

                <ImageButton
                    android:id="@+id/fab_wifi"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/weather_rounded_corner"
                    android:gravity="center"
                    android:padding="5dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/wifi_off"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tx_reminders"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/rounded_corner_gray"
                    android:gravity="center"
                    android:padding="5dp"
                    android:scaleType="fitXY"
                    android:text="🔔"
                    tools:ignore="HardcodedText" />

                <ImageButton
                    android:id="@+id/fab_blue"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/weather_rounded_corner"
                    android:gravity="center"
                    android:padding="5dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/blue_off"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tx_ai"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/rounded_corner_gray"
                    android:gravity="center"
                    android:padding="5dp"
                    android:scaleType="fitXY"
                    android:text="✨"
                    tools:ignore="HardcodedText" />




            </LinearLayout>


            <TextView
                android:id="@+id/tx_weather_icon_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/weather_icon"
                android:layout_marginBottom="-45dp"
                android:layout_alignEnd="@+id/weather_icon"
                android:background="@drawable/gradient_glass"
                android:scaleType="fitXY"
                android:text="25°C"
                android:textColor="?attr/colorTertiary"
                android:textSize="25dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tx_weather_icon_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/weather_icon"
                android:layout_marginBottom="-20dp"
                android:layout_alignStart="@+id/weather_icon"
                android:background="@drawable/gradient_glass"
                android:scaleType="fitXY"
                android:text="Weather..,"
                android:textColor="?attr/colorTertiary"
                android:textStyle="bold" />


            <ImageButton
                android:id="@+id/weather_icon"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:layout_below="@+id/ll_top"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/fab_margin"
                android:layout_marginEnd="5dp"
                android:background="@drawable/weather_rounded_corner"
                android:scaleType="fitXY"
                android:src="@drawable/clouds" />

            <ImageView
                android:id="@+id/animation_image"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:layout_below="@+id/ll_top"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/fab_margin"
                android:layout_marginEnd="5dp"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/tx_live_weather_effects"
                android:visibility="invisible"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:layout_below="@+id/ll_top"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="50dp"
                android:layout_marginTop="25dp"
                android:scaleType="fitXY"
                android:gravity="center"
                android:textSize="35sp"
                android:text="☄" />




            <TextView
                android:id="@+id/tx_ref_weather_icon"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:layout_below="@+id/ll_top"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/fab_margin"
                android:layout_marginEnd="5dp"
                android:scaleType="fitXY"
                android:gravity="center"
                android:textSize="50sp"
                android:text="↻" />


            <AnalogClock
                android:id="@+id/a_clock"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_alignParentStart="true"
                android:layout_below="@+id/ll_top"
                android:dial="@drawable/walp_icon"
                android:hand_second="@drawable/s_hand" />

            <android.widget.TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ll_top"
                android:layout_centerHorizontal="true"
                android:format24Hour="k:mm:ss"
                android:layout_marginTop="@dimen/fab_margin"
                android:layout_marginStart="-10dp"
                android:textColor="?attr/colorPrimaryDark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tx_day_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/clock"
                android:layout_centerHorizontal="true"
                android:text="Day│Date"
                android:textColor="?attr/colorPrimaryDark"
                android:layout_marginStart="-10dp"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />


            <TextView
                android:id="@+id/tx_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/a_clock"
                android:layout_marginStart="@dimen/fab_margin"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text="① Place Info..."
                android:textColor="?attr/colorPrimaryDark"
                android:textSize="15sp"
                android:textStyle="bold">

                <requestFocus />
            </TextView>

        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/rl_contacts"
            android:layout_marginTop="3dp"
            android:layout_below="@+id/rl_clocks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="②Fav..."
                android:textStyle="bold"
                android:background="@drawable/circular_tx_selected"
                android:textSize="15sp"
                android:layout_toStartOf="@+id/imgv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <ImageView
                android:id="@+id/imgv"
                android:layout_centerHorizontal="true"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/contacts"/>

            <TextView
                android:text="Contacts"
                android:textStyle="bold"
                android:layout_toEndOf="@+id/imgv"
                android:textSize="15sp"
                android:background="@drawable/circular_tx_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>



        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_apps"
            android:layout_marginTop="3dp"
            android:layout_below="@+id/rl_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Frequent"
                android:textStyle="bold"
                android:background="@drawable/circular_tx_selected"
                android:textSize="15sp"
                android:layout_toStartOf="@+id/imgv_a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <ImageView
                android:id="@+id/imgv_a"
                android:layout_centerHorizontal="true"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/launch_e"/>

            <TextView
                android:text="④ Apps"
                android:textStyle="bold"
                android:layout_toEndOf="@+id/imgv_a"
                android:textSize="15sp"
                android:background="@drawable/circular_tx_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>



        </RelativeLayout>


        <ProgressBar
            android:id="@+id/progressBar_cyclic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_screentime"
            android:layout_marginStart="@dimen/fab_margin"
            android:layout_marginTop="5dp"
            android:layout_toRightOf="@+id/imgbtn_conf"
            android:indeterminate="true"
            android:indeterminateTint="?attr/colorSecondary"
            android:indeterminateTintMode="src_atop"
            android:minWidth="25dp"
            android:minHeight="25dp"
            android:visibility="invisible" />

        <ImageButton
            android:id="@+id/imgbtn_location"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_below="@+id/rl_screentime"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="@dimen/fab_margin"
            android:layout_toStartOf="@+id/imgbtn_lock"
            android:background="@drawable/rounded_corner_white"
            android:padding="5dp"
            android:scaleType="fitXY"
            android:src="@drawable/location" />

        <ImageButton
            android:id="@+id/imgbtn_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_screentime"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="@dimen/fab_margin"
            android:layout_toStartOf="@+id/imgbtn_conf"
            android:background="@drawable/rounded_corner_black"
            android:padding="5dp"
            android:src="@android:drawable/ic_lock_lock" />

        <ImageButton
            android:id="@+id/imgbtn_conf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_screentime"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="5dp"
            android:background="@drawable/rounded_corner_white"
            android:padding="5dp"
            android:src="@android:drawable/ic_menu_search" />

        <RelativeLayout
            android:id="@+id/rl_screentime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_apps"
            android:layout_margin="5dp"
            android:background="@drawable/gradient_glass_rounded">

            <TextView
                android:id="@+id/tx_st_since"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:text="since, y'day..."
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/btn_screentime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/fab_margin"
                android:background="@android:color/transparent"
                android:text="Screen time ~ 7+ Hrs"
                android:textColor="@android:color/holo_red_light"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tx_screentime_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="5dp"
                android:text="ⓘ"
                android:textSize="25sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />


        </RelativeLayout>




        <ImageButton
            android:id="@+id/imgbtn_set"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_screentime"
            android:layout_marginStart="@dimen/fab_margin"
            android:layout_marginTop="5dp"
            android:layout_toEndOf="@+id/imgbtn_conf"
            android:background="@drawable/rounded_corner_black"
            android:padding="5dp"
            android:src="@android:drawable/ic_popup_sync" />

        <TextView
            android:id="@+id/tx_rewards_count"
            android:text="5"
            android:background="@drawable/gradient_glass_flatbottom"
            android:textStyle="bold"
            android:textColor="@android:color/holo_red_light"
            android:layout_alignTop="@+id/imgbtn_set"
            android:layout_alignStart="@+id/imgbtn_set"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageButton
            android:id="@+id/imgbtn_speech"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_below="@+id/rl_screentime"
            android:layout_marginStart="@dimen/fab_margin"
            android:layout_marginTop="5dp"
            android:layout_toEndOf="@+id/imgbtn_set"
            android:background="@drawable/rounded_corner_white"
            android:padding="5dp"
            android:scaleType="fitXY"
            android:src="@android:drawable/ic_btn_speak_now" />

        <RelativeLayout
            android:id="@+id/rl_steps"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:layout_below="@+id/rl_contacts"
            android:background="@drawable/rounded_corner_gray">

            <TextView
                android:id="@+id/txx_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:text="Steps,"
                android:textColor="@android:color/white"
                android:textStyle="bold|italic" />

            <ImageButton
                android:id="@+id/imgv_steps"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_toEndOf="@+id/txx_steps"
                android:background="@android:color/transparent"
                android:scaleType="fitXY"
                android:src="@drawable/steps" />

            <TextView
                android:id="@+id/tx_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_toEndOf="@+id/imgv_steps"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@android:color/white"
                android:text="③ Steps count"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tx_now_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_toStartOf="@+id/tx_steps_info"
                android:text=" + "
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/vertical_divider"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_toEndOf="@+id/tx_steps"
                android:background="@android:color/black"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tx_n_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_toEndOf="@+id/vertical_divider"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tx_steps_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="5dp"
                android:text="ⓘ"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />


        </RelativeLayout>


        <RelativeLayout
            android:background="@drawable/gradient_glass_rounded"
            android:layout_above="@+id/tx_tweets"
            android:layout_margin="5dp"
            android:visibility="gone"
            android:layout_toRightOf="@+id/twSettings"
            android:layout_toLeftOf="@+id/fab_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tx_sname"
                android:layout_alignParentStart="true"
                android:layout_marginStart="5dp"
                android:layout_centerVertical="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Song name.."/>

            <ImageButton
                android:id="@+id/imgbtn_media_prev"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@+id/tx_sname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_previous"/>


            <ImageButton
                android:id="@+id/imgbtn_media_play_pause"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@+id/imgbtn_media_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_glass_rounded"
                android:src="@android:drawable/ic_media_play"/>


            <ImageButton
                android:id="@+id/imgbtn_media_next"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@+id/imgbtn_media_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_next"/>




        </RelativeLayout>

        <ImageButton
            android:id="@+id/twSettings"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_above="@+id/tx_tweets"
            android:layout_alignParentStart="true"
            android:background="@drawable/gradient_glass"
            android:padding="5dp"
            android:scaleType="fitXY"
            android:src="@drawable/tw" />


        <ImageButton
            android:id="@+id/fab_share"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_above="@+id/tx_tweets"
            android:layout_alignParentEnd="true"
            android:background="@drawable/weather_rounded_corner"
            android:gravity="center"
            android:src="@android:drawable/ic_menu_share"
            tools:ignore="HardcodedText" />



        <TextView
            android:id="@+id/tx_tweets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/tx_desc_walltype"
            android:layout_marginBottom="3dp"
            android:autoLink="all"
            android:background="#80FFFFFF"
            android:ellipsize="end"
            android:gravity="center"
            android:linksClickable="true"
            android:maxLines="3"
            android:text="Tweets"
            android:textColor="?attr/colorPrimaryDark"
            android:textSize="15sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tx_desc_walltype"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:autoLink="web"
            android:background="@drawable/gradient_glass_flattop"
            android:gravity="center"
            android:linksClickable="true"
            android:text="..wallpaper description!"
            android:textColor="?attr/colorPrimaryDark"
            android:textStyle="bold" />


    </RelativeLayout></RelativeLayout>