<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dialog_layout"
    android:background="@drawable/gradient_glass_rounded_ss"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:context=".DialogActivity">

    <LinearLayout
        android:id="@+id/ll_menu"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:layout_below="@+id/tx_dialog_title"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/menu_reminders"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="10dp"
            android:src="@drawable/bell_hr"
            android:background="@drawable/rounded_corner_gray"
            android:scaleType="fitXY"
            android:padding="10dp"
            android:contentDescription="Reminders" />

        <ImageButton
            android:id="@+id/menu_torch"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="10dp"
            android:src="@drawable/torch_off"
            android:background="@drawable/rounded_corner_gray"
            android:scaleType="fitXY"
            android:padding="10dp"
            android:contentDescription="Torch" />

        <ImageButton
            android:id="@+id/menu_wifi"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="10dp"
            android:src="@drawable/wifi_off"
            android:background="@drawable/rounded_corner_gray"
            android:scaleType="fitXY"
            android:padding="10dp"
            android:contentDescription="Wifi" />

        <ImageButton
            android:id="@+id/menu_blue"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="10dp"
            android:src="@drawable/blue_off"
            android:background="@drawable/rounded_corner_gray"
            android:scaleType="fitXY"
            android:padding="10dp"
            android:contentDescription="Bluetooth" />

        <ImageButton
            android:id="@+id/menu_ai"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="10dp"
            android:src="@drawable/ai"
            android:background="@drawable/rounded_corner_gray"
            android:scaleType="fitXY"
            android:padding="10dp"
            android:contentDescription="AI" />

    </LinearLayout>

    <ImageView
        android:id="@+id/dialog_imgv_cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_centerInParent="true"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tx_dialog_title"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:text="Dialog Title"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textStyle="bold"
        android:layout_margin="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ImageButton
        android:id="@+id/tw_config"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:scaleType="fitXY"
        android:background="@android:color/transparent"
        android:layout_alignBottom="@+id/tx_dialog_title"
        android:layout_toEndOf="@+id/tx_dialog_title"
        android:layout_marginStart="8dp"
        android:src="@drawable/fact"/>

    <TextView
        android:id="@+id/tx_dialog_content"
        android:visibility="gone"
        android:gravity="center_horizontal"
        android:layout_below="@+id/edtx_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"/>

    <LinearLayout
        android:id="@+id/ll_buttons"
        android:layout_below="@+id/tx_dialog_content"
        android:layout_centerHorizontal="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btn_dialog_ok"
            android:text="Ok"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/imgbtn_dialog_share"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Share"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_share" />

        <Button
            android:id="@+id/btn_dialog_cancel"
            style="?attr/materialButtonOutlinedStyle"
            android:text="Cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_activity_container"
        android:layout_below="@+id/ll_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_screen_time"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tx_dialog_title"
        android:layout_above="@+id/tx_avg_usage"
        android:visibility="gone"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        tools:listitem="@layout/item_screen_time" />

    <TextView
        android:id="@+id/tx_avg_usage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:padding="16dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone"
        tools:text="Avg Usage/Day ~ 2 Hours : 30 Mins" />

    <EditText
        android:id="@+id/edtx_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/tx_dialog_title"
        android:layout_marginHorizontal="32dp"
        android:hint="Enter text..."
        android:visibility="gone"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_dialog"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tx_dialog_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/vp_dialog"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:tabBackground="@drawable/tab_selector"
        app:tabIndicatorHeight="0dp"
        app:tabGravity="center"
        app:tabMaxWidth="24dp"
        app:tabMinWidth="24dp"
        app:tabMode="fixed"
        app:tabRippleColor="@null"
        android:background="@android:color/transparent" />

</RelativeLayout>