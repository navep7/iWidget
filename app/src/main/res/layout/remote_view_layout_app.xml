<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="90dp"
    android:layout_height="90dp">

    <ImageView
        android:id="@+id/app_imgv"
        android:src="@drawable/launch_e"
        android:layout_above="@+id/app_tx"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/app_tx"
        android:tag="APP"
        android:text="App"
        android:background="@drawable/gradient_glass_flat"
        android:textStyle="bold"
        android:maxLines="1"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:src="@drawable/contacts"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/app_time"
        android:tag="APP"
        android:text="99"
        android:textSize="13sp"
        android:textColor="@android:color/holo_red_dark"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_alignParentTop="true"
        android:layout_marginStart="-20dp"
        android:layout_toRightOf="@+id/app_imgv"
        android:src="@drawable/contacts"
        tools:ignore="HardcodedText" />


</RelativeLayout>