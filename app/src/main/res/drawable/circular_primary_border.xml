<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Background color of the TextView -->
    <stroke
        android:width="5dp"
        android:color="?attr/colorPrimary" /> <!-- Border color and width -->
    <corners android:radius="999dp" /> <!-- Large radius for circular effect -->
    <padding
        android:bottom="8dp"
        android:left="16dp"
        android:right="16dp"
        android:top="8dp" /> <!-- Optional padding for text inside the border -->
</shape>